/*
*********************************************************************************************************
* 函数名 : MBSerialSlavePort_PresetMultipleRegisters
* 入口参数 : value - 寄存器值
*          addr  - 寄存器起始地址
*          num   - 寄存器个数
* 返回值 : 预置成功返回MB_ERROR_FREE，预置失败返回错误码
* 说明 : Modbus从机预置多个寄存器通讯接口函数
*********************************************************************************************************
*/

static INT32S MBSerialSlavePort_PresetMultipleRegisters(INT16U *value, INT16U addr, INT16U num) C51_REENTRANT
{
    INT16U *pwdata;

    pwdata = MBSerialSlavePort_RegistersAddrCheck(addr, num);
    if (!pwdata) {
        return MB_ERROR_ADDR;
    }

    memcpy(pwdata, value, num * 2);

    return MB_ERROR_FREE;
}

/*
*********************************************************************************************************
* 函数名 : MBSerialSlavePort_MaskWriteRegister
* 入口参数 : addr    - 寄存器地址
*          andmask - 与掩码
*          ormask  - 或掩码
* 返回值 : 写寄存器成功返回MB_ERROR_FREE，写失败返回错误码
* 说明 : 掩码写寄存器
*********************************************************************************************************
*/

static INT32S MBSerialSlavePort_MaskWriteRegister(INT16U addr, INT16U andmask, INT16U ormask) C51_REENTRANT
{
    INT16U *pwdata;

    pwdata = MBSerialSlavePort_RegistersAddrCheck(addr, 1);
    if (!pwdata) {
        return MB_ERROR_ADDR;
    }

    *pwdata = (*pwdata & andmask) | (ormask & ~andmask);

    return MB_ERROR_FREE;
}

/*
*********************************************************************************************************
* 函数名 : MBSerialSlavePort_ReadWriteMultipleRegisters
* 入口参数 : value_rd    - 读寄存器值
*          reg_addr_rd - 读寄存器地址
*          num_rd      - 读寄存器个数
*          value_wr    - 写寄存器值
*          reg_addr_wr - 写寄存器地址
*          num_wr      - 写寄存器个数
* 返回值 : 读写成功返回MB_ERROR_FREE，读写失败返回错误码
* 说明 : Modbus从机读写多个寄存器通讯接口函数
*********************************************************************************************************
*/

static INT32S MBSerialSlavePort_ReadWriteMultipleRegisters(INT16U *value_rd, INT16U reg_addr_rd, INT16U num_rd, INT16U *value_wr, INT16U reg_addr_wr, INT16U num_wr) C51_REENTRANT
{
    INT16U *pwdata;

    pwdata = MBSerialSlavePort_RegistersAddrCheck(reg_addr_rd, num_rd);
    if (!pwdata) {
        return MB_ERROR_ADDR;
    }
    memcpy(value_rd, pwdata, num_rd * 2);

    pwdata = MBSerialSlavePort_RegistersAddrCheck(reg_addr_wr, num_wr);
    if (!pwdata) {
        return MB_ERROR_ADDR;
    }
    memcpy(pwdata, value_wr, num_wr * 2);

    return MB_ERROR_FREE;
}

/*
*********************************************************************************************************
* 函数名 : MBSerialSlavePort_ReadDecreteInputs
* 入口参数 : resp - 存放应答帧的地址
*          addr - 输入地址
*          num  - 输入个数
* 返回值 : 读取成功返回MB_ERROR_FREE，读取失败返回错误码
* 说明 : Modbus从机读离散输入通讯接口函数
*********************************************************************************************************
*/

static INT32S MBSerialSlavePort_ReadDecreteInputs(INT8U *resp, INT16U addr, INT16U num) C51_REENTRANT
{
    return MBSerialSlavePort_ReadCoils(resp, addr, num);
}

