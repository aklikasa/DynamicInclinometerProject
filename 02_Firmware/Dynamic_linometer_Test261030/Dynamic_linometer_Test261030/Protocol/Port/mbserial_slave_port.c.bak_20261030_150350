/*
*********************************************************************************************************
* 函数名 : MBSerialSlavePort_ReadHoldingRegisters
* 入口参数 : presp_buf - 存放应答帧的地址
*          addr      - 保持寄存器地址
*          num       - 保持寄存器个数
* 返回值 : 读取成功返回MB_ERROR_FREE，读取失败返回错误码
* 说明 : Modbus从机读保持寄存器通讯接口函数
*********************************************************************************************************
*/

static INT32S MBSerialSlavePort_ReadHoldingRegisters(INT16U *presp_buf, INT16U addr, INT16U num) C51_REENTRANT
{
    INT16U *pwdata;



    // 参数区(3000起，只读)：MCU唯一标识(96位=6个寄存器，高16位在前)..
    if ((addr >= MB_REG_PARAM_BASE_HR) && ((INT32U)addr + num <= (INT32U)MB_REG_PARAM_BASE_HR + PARAM_MCU_UID_REG_NUM)) {
        memcpy(presp_buf, &DynamicLinometerParam.UidReg[addr - MB_REG_PARAM_BASE_HR], num * 2);
        return MB_ERROR_FREE;
    }
	    // 刷新ASM330 FIFO最新数据(未读批次数为0时清空数据区，上位机据此判断无新数据)
    App_Asm330FifoRefresh(&Asm330MBData);

    pwdata = MBSerialSlavePort_RegistersAddrCheck(addr, num);//可读可写的地址
    if (!pwdata) {
        return MB_ERROR_ADDR;
    }

    memcpy(presp_buf, pwdata, num * 2);

    return MB_ERROR_FREE;
}

/*
*********************************************************************************************************
* 函数名 : MBSerialSlavePort_ReadInputRegisters
* 入口参数 : presp_buf - 存放应答帧的地址
*          addr      - 输入寄存器地址
*          num       - 输入寄存器个数
* 返回值 : 读取成功返回MB_ERROR_FREE，读取失败返回错误码
* 说明 : Modbus从机读输入寄存器通讯接口函数
*********************************************************************************************************
*/

static INT32S MBSerialSlavePort_ReadInputRegisters(INT16U *presp_buf, INT16U addr, INT16U num) C51_REENTRANT
{
    INT16U *pwdata;

    // 刷新ASM330 FIFO最新数据(未读批次数为0时清空数据区，上位机据此判断无新数据)
    App_Asm330FifoRefresh(&Asm330MBData);

    // 参数区(3000起，只读)：MCU唯一标识(96位=6个寄存器，高16位在前)
    if ((addr >= MB_REG_PARAM_BASE_HR) && ((INT32U)addr + num <= (INT32U)MB_REG_PARAM_BASE_HR + PARAM_MCU_UID_REG_NUM)) {
        memcpy(presp_buf, &DynamicLinometerParam.UidReg[addr - MB_REG_PARAM_BASE_HR], num * 2);
        return MB_ERROR_FREE;
    }

    pwdata = MBSerialSlavePort_RegistersAddrCheck(addr, num);
    if (!pwdata) {
        return MB_ERROR_ADDR;
    }

    memcpy(presp_buf, pwdata, num * 2);

    return MB_ERROR_FREE;
}

