* 返回值 : 转换成功返回TRUE，转换失败返回FALSE
* 说明 : 线圈地址转换(本工程未使用线圈功能，直接返回TRUE)
*********************************************************************************************************
*/

static BOLEAN MBSerialSlavePort_MBCoilAddrToMemAdrr(INT16U coil_addr, INT8U **mem_addr, INT8U *bit)
{
    return TRUE;
}

/*
*********************************************************************************************************
* 函数名 : MBSerialSlavePort_RegistersAddrCheck
* 入口参数 : addr - 寄存器起始地址
*          num  - 寄存器个数
* 返回值 : 寄存器地址有效返回对应内存地址，无效返回NULL
* 说明 : 检查寄存器Modbus地址是否有效，并获取对应的内存地址
*********************************************************************************************************
*/

static INT16U *MBSerialSlavePort_RegistersAddrCheck(INT16U addr, INT16U num) C51_REENTRANT
{
    INT16U *pwdata;

    pwdata = MBSerialSlavePort_MBRegAddrToMemAdrr(addr);
    if (!pwdata) {
        return (INT16U *)0;
    }
    if (!MBSerialSlavePort_MBRegAddrToMemAdrr(addr + num - 1)) {
        return (INT16U *)0;
    }

    return pwdata;
}

