#define MB_REG_ASM330_BASE_HR      1000    // 保持寄存器起始地址(功能码0x03/0x10)
#define MB_REG_ASM330_BASE_IR      5000    // 输入寄存器起始地址(功能码0x04)
#define MB_REG_PARAM_BASE_HR       3000    // 参数区起始地址(功能码0x03/0x04)：MCU唯一标识(只读)

ASM330_DATA Asm330MBData;                   // Modbus寄存器映射的ASM330六轴数据

/*
*********************************************************************************************************
* 函数名 : MBSerialSlavePort_MBRegAddrToMemAdrr
* 入口参数 : addr - Modbus寄存器地址
* 返回值 : Modbus寄存器地址对应的内存地址
* 说明 : 保持寄存器1000段、输入寄存器5000段映射到ASM330六轴数据
*********************************************************************************************************
*/

static INT16U *MBSerialSlavePort_MBRegAddrToMemAdrr(INT16U addr) C51_REENTRANT
{
    INT16U *pwdata_base;
    INT16U addr_off;
    INT16U max_size;

    if ((addr >= MB_REG_ASM330_BASE_HR) && (addr < MB_REG_ASM330_BASE_HR + sizeof(Asm330MBData) / 2)) {
        addr_off    = addr - MB_REG_ASM330_BASE_HR;
        max_size    = sizeof(Asm330MBData);
        pwdata_base = (INT16U *)&Asm330MBData;
    } else if ((addr >= MB_REG_ASM330_BASE_IR) && (addr < MB_REG_ASM330_BASE_IR + sizeof(Asm330MBData) / 2)) {
        addr_off    = addr - MB_REG_ASM330_BASE_IR;
        max_size    = sizeof(Asm330MBData);
        pwdata_base = (INT16U *)&Asm330MBData;
    } 
      else {
        return (INT16U *)0;
    }

    if (addr_off * 2 >= max_size) {        // 不能超过结构体的长度
        return NULL;
    } else {
        return (pwdata_base + addr_off);
    }
}

/*
*********************************************************************************************************
* 函数名 : MBSerialSlavePort_MBCoilAddrToMemAdrr
* 入口参数 : coil_addr - 线圈地址
