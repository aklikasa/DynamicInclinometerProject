#include "mbserial_defs.h"
#include "mbserial_config.h"
#include "mbserial_slave.h"
#include "mbserial_slave_port.h"

UART_HandleTypeDef huart1;          // USART1句柄
DMA_HandleTypeDef hdma_usart1_rx;   // USART1接收DMA句柄
DMA_HandleTypeDef hdma_usart1_tx;   // USART1发送DMA句柄

USART_MB_SLAVE_CTRL USart1_MBSlaveCtrl;

/*
*********************************************************************************************************
* 函数名 : App_USart1Chip485DESet
* 入口参数 : bVal - 1:485进入发送态(DE置高)，0:485进入接收态(DE置低)
* 返回值 : 无
* 说明 : 控制USART1的485方向控制引脚
*********************************************************************************************************
*/

void App_USart1Chip485DESet(BOLEAN bVal)
{
    if (bVal) {
        HAL_GPIO_WritePin(USART1_485_DE_PORT, USART1_485_DE_PIN, GPIO_PIN_SET);
    } else {
        HAL_GPIO_WritePin(USART1_485_DE_PORT, USART1_485_DE_PIN, GPIO_PIN_RESET);
    }
}

/*
*********************************************************************************************************
* 函数名 : App_USart1PortCfg
* 入口参数 : 无
* 返回值 : 无
* 说明 : 配置USART1的485方向控制引脚，默认接收态
*********************************************************************************************************
*/

void App_USart1PortCfg(void)
{
    GPIO_InitTypeDef GPIO_InitStruct = {0};

    __HAL_RCC_GPIOA_CLK_ENABLE();

    GPIO_InitStruct.Pin   = USART1_485_DE_PIN;
    GPIO_InitStruct.Mode  = GPIO_MODE_OUTPUT_PP;
    GPIO_InitStruct.Pull  = GPIO_NOPULL;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;
    HAL_GPIO_Init(USART1_485_DE_PORT, &GPIO_InitStruct);

    App_USart1Chip485DESet(0); // 默认接收态
}

/*
*********************************************************************************************************
* 函数名 : App_USart1DmaRxRecfg
* 入口参数 : 无
* 返回值 : 无
* 说明 : 重新挂载USART1的DMA接收，接收空闲时由接收空闲中断通知
*********************************************************************************************************
*/

void App_USart1DmaRxRecfg(void)
{
    if (huart1.RxState == HAL_UART_STATE_BUSY_RX) {
        HAL_UART_DMAStop(&huart1);
    }

    HAL_UARTEx_ReceiveToIdle_DMA(&huart1, (uint8_t *)&USart1_MBSlaveCtrl.RecvBuffer[0], (uint16_t)sizeof(USart1_MBSlaveCtrl.RecvBuffer));
}

/*
*********************************************************************************************************
* 函数名 : App_USart1Init
* 入口参数 : baudrate - 串口波特率
* 返回值 : 初始化成功返回HAL_OK，失败返回HAL_ERROR
* 说明 : USART1初始化：
*        帧格式寄存器配置(1起始位+8数据位+1停止位，即8N1)：
*          CR1.M[1:0]   = 00  -> 8位数据长度(UART_WORDLENGTH_8B)
*          CR1.PCE      = 0   -> 无校验(UART_PARITY_NONE)
*          CR2.STOP[1:0]= 00  -> 1个停止位(UART_STOPBITS_1)
*        接收使用DMA+接收空闲中断通知，发送使用DMA+发送完成中断通知
*********************************************************************************************************
*/

HAL_StatusTypeDef App_USart1Init(INT32U baudrate)
{
    huart1.Instance                  = USART1;
    huart1.Init.BaudRate             = baudrate;
    huart1.Init.WordLength           = UART_WORDLENGTH_8B;  // CR1.M[1:0]=00，8位数据长度
    huart1.Init.StopBits             = UART_STOPBITS_1;     // CR2.STOP[1:0]=00，1个停止位
    huart1.Init.Parity               = UART_PARITY_NONE;    // CR1.PCE=0，无校验位
    huart1.Init.Mode                 = UART_MODE_TX_RX;
    huart1.Init.HwFlowCtl            = UART_HWCONTROL_NONE;
    huart1.Init.OverSampling         = UART_OVERSAMPLING_16;
    huart1.Init.OneBitSampling       = UART_ONE_BIT_SAMPLE_DISABLE;
    huart1.AdvancedInit.AdvFeatureInit = UART_ADVFEATURE_NO_INIT;
    if (HAL_UART_Init(&huart1) != HAL_OK) {
        return HAL_ERROR;
    }

    // 使能USART1全局中断(用于空闲中断与发送完成中断通知)
    HAL_NVIC_SetPriority(USART1_IRQn, 0, 0);
    HAL_NVIC_EnableIRQ(USART1_IRQn);

    App_USart1PortCfg();

    USart1_MBSlaveCtrl.RecvCount         = 0;
    USart1_MBSlaveCtrl.SendCount         = 0;
    USart1_MBSlaveCtrl.MBRespLen         = 0;
    USart1_MBSlaveCtrl.MBFrameIsReceived = FALSE;
    USart1_MBSlaveCtrl.MBFrameIsSent     = FALSE;

    // Modbus从机初始化(独立端口号)
    MBSerialSlaveInit(USART1_MB_PORT, USART1_MB_SLAVE_ADDR, MB_SERIAL_MODE_RTU, MBSerialSlavePortCommIfPtr);

    App_USart1DmaRxRecfg(); // 挂载DMA接收，等待接收Modbus帧
	
	App_USart1Chip485DESet(0); // 485进入接收态

    return HAL_OK;
}

/*
*********************************************************************************************************
* 函数名 : App_USart1TCHandle
* 入口参数 : 无
* 返回值 : 无
* 说明 : 复位收发计数，485进入接收态，重新挂载DMA接收
*********************************************************************************************************
*/

void App_USart1TCHandle(void)
{
    USart1_MBSlaveCtrl.RecvCount         = 0;
    USart1_MBSlaveCtrl.SendCount         = 0;
    USart1_MBSlaveCtrl.MBRespLen         = 0;
    USart1_MBSlaveCtrl.MBFrameIsReceived = FALSE;
    USart1_MBSlaveCtrl.MBFrameIsSent     = FALSE;

    App_USart1Chip485DESet(0); // 485进入接收态
    App_USart1DmaRxRecfg();    // 重新挂载DMA接收
}

/*
*********************************************************************************************************
* 函数名 : App_USart1RCIdleHandle
* 入口参数 : 无
* 返回值 : 无
* 说明 : 接收空闲中断处理：校验从机地址，设置Modbus帧接收完成标志
*********************************************************************************************************
*/

static void App_USart1RCIdleHandle(void)
{
    INT8U slave_addr_geted;

    if (USart1_MBSlaveCtrl.RecvCount < 4) { // 帧长过短(从机地址+功能码+CRC16)
        USart1_MBSlaveCtrl.MBFrameIsReceived = FALSE;
        App_USart1TCHandle();
        return;
    }

    // 校验从机地址
    slave_addr_geted = MBGetAddress(&USart1_MBSlaveCtrl.RecvBuffer[0]);
    if (slave_addr_geted != USART1_MB_SLAVE_ADDR) {
        USart1_MBSlaveCtrl.MBFrameIsReceived = FALSE;
        App_USart1TCHandle(); // 不是本机地址，重新进入接收
    } else {
        USart1_MBSlaveCtrl.MBFrameIsReceived = TRUE;
    }
}

/*
*********************************************************************************************************
* 函数名 : App_USart1RxEvent
* 入口参数 : Size - 本次接收到的字节数
* 返回值 : 无
* 说明 : 接收空闲中断事件处理：由中断层按串口实例路由调用
*********************************************************************************************************
*/

void App_USart1RxEvent(uint16_t Size)
{
    USart1_MBSlaveCtrl.RecvCount = Size;
    App_USart1RCIdleHandle();
}

/*
*********************************************************************************************************
* 函数名 : App_USart1TxCplt
* 入口参数 : 无
* 返回值 : 无
* 说明 : 发送完成中断事件处理：由中断层按串口实例路由调用
*********************************************************************************************************
*/

void App_USart1TxCplt(void)
{
    USart1_MBSlaveCtrl.MBFrameIsSent = TRUE;
    App_USart1Chip485DESet(0); // 485回到接收态
}

/*
*********************************************************************************************************
* 函数名 : App_USart1MBFramePolling
* 入口参数 : 无
* 返回值 : 无
* 说明 : 轮询处理Modbus从机帧和应答帧发送完成状态
*********************************************************************************************************
*/

void App_USart1MBFramePolling(void)
{
    // 应答帧发送完成
    if (USart1_MBSlaveCtrl.MBFrameIsSent) {
        USart1_MBSlaveCtrl.MBFrameIsSent = FALSE;
		App_Asm330DataRefreshTxDone();

        return;
    }

    // 收到完整Modbus帧
    if (USart1_MBSlaveCtrl.MBFrameIsReceived) {
        USart1_MBSlaveCtrl.MBFrameIsReceived = FALSE;

        // 处理Modbus从机帧，生成应答帧
        USart1_MBSlaveCtrl.MBRespLen = MBSerialSlaveFrameProcess(USART1_MB_PORT, USart1_MBSlaveCtrl.SendBuffer, USart1_MBSlaveCtrl.RecvBuffer, USart1_MBSlaveCtrl.RecvCount);
        if (USart1_MBSlaveCtrl.MBRespLen > 0) {
			
			App_USart1Chip485DESet(1); // 485进入发送态
            USart1_MBSlaveCtrl.SendCount     = 0;
            USart1_MBSlaveCtrl.MBFrameIsSent = FALSE;

            if (HAL_UART_Transmit_DMA(&huart1, USart1_MBSlaveCtrl.SendBuffer, (uint16_t)USart1_MBSlaveCtrl.MBRespLen) != HAL_OK) {
                App_USart1TCHandle(); // 挂载发送DMA失败，重新进入接收
            }
        } else {
            App_USart1TCHandle(); // 无应答帧，重新进入接收
        }
    }
}
