<ui version="4.0">
 <class>mainWindow</class>
 <widget class="QMainWindow" name="mainWindow">
  <property name="styleSheet"><string notr="true">
/* Compact Liquid Glass | Dynamic Inclinometer */
QMainWindow { background: #e8ebed; color: #30353a; font-family: "Microsoft YaHei UI", "PingFang SC", "Segoe UI"; font-size: 12px; }
QWidget#centralwidget { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #f5f6f7,stop:0.48 #ecf0f1,stop:1 #e5e9eb); }
QGroupBox {
  color: #4b545c; font-size: 12px; font-weight: 600;
  border: 1px solid #d9dfe2; border-top: 1px solid #ffffff;
  border-radius: 15px; margin-top: 13px; padding-top: 11px;
  background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
     stop:0 rgba(255,255,255,248),stop:0.15 rgba(255,255,255,239),stop:1 rgba(249,251,251,232));
}
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left;
  left: 16px; top: 1px; padding: 0 7px 0 5px; color: #535a60;
  background: transparent; }
QTabWidget::pane { border: 1px solid #dce1e5; border-top: 1px solid #ffffff;
  border-radius: 11px; background: rgba(255,255,255,224); top: -1px; }
QTabBar::tab {
  color: #707983; min-width: 60px; padding: 8px 12px; margin-right: 4px;
  background: rgba(238,241,243,153); border: 1px solid transparent;
  border-top-left-radius: 9px; border-top-right-radius: 9px;
}
QTabBar::tab:selected {
  color: #293038; font-weight: 600; border: 1px solid #dce1e5;
  border-bottom-color: #fefefe;
  background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #ffffff,stop:1 #f8fafa);
}
QTabBar::tab:hover:!selected { background: rgba(255,255,255,206); color: #424b53; }
QPushButton {
  color: #444b53; min-height: 19px; padding: 3px 8px;
  border: 1px solid #cdd4d9; border-top: 1px solid #ffffff;
  border-radius: 9px;
  background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #ffffff,stop:0.42 #fbfcfc,stop:1 #eaedef);
}
QPushButton:hover {
  color: #252c32; border-color: #aeb7be;
  background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #ffffff,stop:1 #f2f5f6);
}
QPushButton:pressed { padding-top: 5px; padding-bottom: 3px;
  border-color: #b5bec5; background: #e1e6e9; }
QPushButton:disabled { color: #acb1b5; border: 1px solid #e3e6e8; background: #f0f2f3; }
QPushButton#pushButton_DataRecordStart,
QPushButton#button_IncCommPortOpen {
  color: #ffffff; font-weight: 600; border: 1px solid #313840; border-top-color: #737d86;
  background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #717a83,stop:0.08 #555f69,stop:1 #303840);
}
QPushButton#pushButton_DataRecordStart:hover,
QPushButton#button_IncCommPortOpen:hover {
  border-color: #484f56; background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #818a93,stop:1 #414b54);
}
QPushButton#pushButton_DataRecordStart:pressed, QPushButton#button_IncCommPortOpen:pressed {
  background: #30383f;
}
QPushButton#pushButton_DataRecordStart[recording="true"] {
  color: #7b4546; border: 1px solid #d9bdbd; border-top-color: #fffafa;
  background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #fffafa,stop:1 #f3e2e2);
}
QPushButton#pushButton_closeWindows { color: #5c6369; min-height: 0px; border-radius: 8px; }
QLineEdit, QTextEdit, QPlainTextEdit, QTextBrowser, QComboBox, QSpinBox, QDoubleSpinBox {
  color: #394048; selection-background-color: #adb9c1;
  border: 1px solid #d6dce0; border-top: 1px solid #cbd2d6;
  border-radius: 8px; padding: 4px 7px;
  background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #f7f9f9,stop:0.2 #ffffff,stop:1 #ffffff);
}
QTextBrowser { background: #fafbfb; }
QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
  border: 1px solid #99a5af; background: #ffffff;
}
QComboBox::drop-down { border: none; width: 22px; }
QComboBox::down-arrow { width: 7px; height: 7px; }
QAbstractItemView { alternate-background-color: #f7f9fa; background: #ffffff; }
QTableWidget { color: #343b42; background: #ffffff; alternate-background-color: #f5f7f8;
  gridline-color: #ecf0f2; border: 1px solid #e1e6e9; border-radius: 8px;
  selection-background-color: #e2e8ec; selection-color: #232b31; }
QHeaderView::section { color: #657078; background: #f4f6f7; border: none;
  border-bottom: 1px solid #dee3e6; border-right: 1px solid #e6ebed; padding: 6px; font-weight: 600; }
QProgressBar { background: #eef1f2; color: #525c64; border: 1px solid #d9e0e4; border-radius: 7px; text-align: center; }
QProgressBar::chunk { border-radius: 6px; background: #939fa8; }
QCheckBox { spacing: 6px; color: #505860; }
QScrollBar:vertical { background: #f2f4f5; width: 10px; border: none; margin: 1px; }
QScrollBar::handle:vertical { background: #cdd5db; min-height: 24px; border-radius: 4px; }
QScrollBar::add-line:vertical,QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar:horizontal { background: #f2f4f5; height: 10px; border: none; margin: 1px; }
QScrollBar::handle:horizontal { background: #cdd5db; min-width: 24px; border-radius: 4px; }
QScrollBar::add-line:horizontal,QScrollBar::sub-line:horizontal { width: 0px; }
QToolTip { background: #fbfcfc; color: #353c43; border: 1px solid #ced6db; padding: 5px; }
