<Window x:Class="Dts.Wpf.TestWindows.CT09.CT09Window"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="CT-09 · Gyro零速残差与姿态相关性" Width="1180" Height="820"
 MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterOwner" Background="#F3F7FC">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="White" CornerRadius="9" Padding="14" Margin="0,0,0,12">
   <StackPanel>
    <TextBlock Text="CT-09 / Gyro零速残差与姿态相关性" FontSize="23" FontWeight="Bold" Foreground="#173B60"/>
    <TextBlock x:Name="DeviceText" Margin="0,6,0,0" Foreground="#23649B"/>
    <TextBlock x:Name="CalibrationText" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#526D86"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="370"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <Border Background="White" CornerRadius="9" Padding="13" Margin="0,0,0,10">
      <StackPanel>
       <TextBlock Text="① 姿态与采集参数" FontSize="17" FontWeight="Bold"/>
       <TextBlock Text="姿态计划（内轴°,外轴°；分号分隔）" Margin="0,9,0,3"/>
       <TextBox x:Name="PoseBox" Height="82" AcceptsReturn="True" TextWrapping="Wrap"
         Text="0,0;90,0;180,0;270,0;0,90;0,180"/>
       <TextBlock Text="每个姿态重复次数" Margin="0,8,0,3"/><TextBox x:Name="RepeatBox" Text="3"/>
       <TextBlock Text="姿态定位速度 (°/s)" Margin="0,8,0,3"/><TextBox x:Name="SpeedBox" Text="5"/>
       <TextBlock Text="到位后静置 (s)" Margin="0,8,0,3"/><TextBox x:Name="SettleBox" Text="10"/>
       <TextBlock Text="每次采集时长 (s)" Margin="0,8,0,3"/><TextBox x:Name="SampleBox" Text="30"/>
       <TextBlock Text="到位容差 (°)" Margin="0,8,0,3"/><TextBox x:Name="ToleranceBox" Text="0.2"/>
       <TextBlock Text="允许最小角度 (°)" Margin="0,8,0,3"/><TextBox x:Name="MinTravelBox" Text="0"/>
       <TextBlock Text="允许最大角度 (°)" Margin="0,8,0,3"/><TextBox x:Name="MaxTravelBox" Text="360"/>
       <TextBlock Text="最少有效帧" Margin="0,8,0,3"/><TextBox x:Name="MinSamplesBox" Text="50"/>
       <TextBlock Text="最大异常剔除比例" Margin="0,8,0,3"/><TextBox x:Name="MaxOutlierBox" Text="0.10"/>
       <Button Content="检查参数并预览" Click="PreviewClick" Margin="0,12,0,0" Padding="8"/>
      </StackPanel>
     </Border>
     <Border Background="White" CornerRadius="9" Padding="13">
      <StackPanel>
       <TextBlock Text="② 安全确认" FontSize="17" FontWeight="Bold"/>
       <CheckBox x:Name="DirectionCheck" Content="已核对内/外轴映射、目标姿态和运动方向" Margin="0,10,0,5"/>
       <CheckBox x:Name="SafetyCheck" Content="已确认夹具、线缆、机械限位及实体急停可用" Margin="0,3,0,5"/>
       <TextBlock Text="CT-09会自动定位转台。每次采集前确认两轴静止并到位；全程现场监护。软件软停车不能替代实体急停。" TextWrapping="Wrap" Foreground="#8A5A24" Margin="0,8,0,0"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="White" CornerRadius="9" Padding="13" Margin="0,0,0,10">
     <StackPanel>
      <TextBlock Text="测试进度" FontSize="17" FontWeight="Bold"/>
      <TextBlock x:Name="ProgressText" Text="等待开始" Margin="0,6,0,0"/>
      <ProgressBar x:Name="RunProgressBar" Height="9" Minimum="0" Maximum="100" Value="0" Margin="0,8,0,0"/>
      <TextBlock x:Name="StatusText" Text="请先连接IMU和2TD，并在主界面选择UID匹配的常温ACC/Gyro标定。" TextWrapping="Wrap" Foreground="#526D86" Margin="0,8,0,0"/>
     </StackPanel>
    </Border>
    <TabControl Grid.Row="1" x:Name="ResultTabs">
     <TabItem Header="逐次采集">
      <DataGrid x:Name="RunsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
       <DataGrid.Columns>
        <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="55"/>
        <DataGridTextColumn Header="姿态" Binding="{Binding PoseIndex}" Width="55"/>
        <DataGridTextColumn Header="重复" Binding="{Binding Repeat}" Width="55"/>
        <DataGridTextColumn Header="内轴°" Binding="{Binding Inner}" Width="75"/>
        <DataGridTextColumn Header="外轴°" Binding="{Binding Outer}" Width="75"/>
        <DataGridTextColumn Header="Gyro X均值" Binding="{Binding Gx}" Width="95"/>
        <DataGridTextColumn Header="Gyro Y均值" Binding="{Binding Gy}" Width="95"/>
        <DataGridTextColumn Header="Gyro Z均值" Binding="{Binding Gz}" Width="95"/>
        <DataGridTextColumn Header="零速模" Binding="{Binding Norm}" Width="90"/>
        <DataGridTextColumn Header="有效帧" Binding="{Binding Frames}" Width="80"/>
        <DataGridTextColumn Header="温度℃" Binding="{Binding Temp}" Width="75"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
     <TabItem Header="姿态汇总">
      <DataGrid x:Name="PoseGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
       <DataGrid.Columns>
        <DataGridTextColumn Header="姿态" Binding="{Binding PoseIndex}" Width="60"/>
        <DataGridTextColumn Header="内轴°" Binding="{Binding Inner}" Width="80"/>
        <DataGridTextColumn Header="外轴°" Binding="{Binding Outer}" Width="80"/>
        <DataGridTextColumn Header="重复" Binding="{Binding Runs}" Width="60"/>
        <DataGridTextColumn Header="Gyro X" Binding="{Binding Gx}" Width="100"/>
        <DataGridTextColumn Header="Gyro Y" Binding="{Binding Gy}" Width="100"/>
        <DataGridTextColumn Header="Gyro Z" Binding="{Binding Gz}" Width="100"/>
        <DataGridTextColumn Header="零速模" Binding="{Binding Norm}" Width="100"/>
        <DataGridTextColumn Header="温度℃" Binding="{Binding Temp}" Width="80"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="White" CornerRadius="9" Padding="12" Margin="0,10,0,0">
     <StackPanel>
      <TextBlock Text="核心指标" FontWeight="Bold"/>
      <TextBlock x:Name="MetricsText" Text="姿态间Gyro零速残差、姿态均值范围、轮内噪声及温度范围将在真实采集完成后计算。" TextWrapping="Wrap" Margin="0,5,0,0"/>
      <TextBlock x:Name="OutputText" TextWrapping="Wrap" Foreground="#58738D" Margin="0,5,0,0"/>
     </StackPanel>
    </Border>
   </Grid>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,12,0,0">
   <Button x:Name="StartButton" DockPanel.Dock="Right" Content="开始真实测试" Click="StartClick" Padding="13,7" Margin="6,0,0,0"/>
   <Button x:Name="StopButton" DockPanel.Dock="Right" Content="停止 / 请求软停车" Click="StopClick" Padding="13,7" IsEnabled="False" Margin="6,0,0,0"/>
   <Button x:Name="ReportButton" DockPanel.Dock="Right" Content="打开HTML报告" Click="ReportClick" Padding="13,7" IsEnabled="False" Margin="6,0,0,0"/>
   <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="关闭" Click="CloseClick" Padding="13,7"/>
  </DockPanel>
 </Grid>
</Window>
