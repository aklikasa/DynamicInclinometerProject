<Window x:Class="Dts.Wpf.TestWindows.CT12A.CT12AWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="CT-12A · Allan 方差／随机稳定性表征" Width="1230" Height="830"
 MinWidth="1040" MinHeight="690" WindowStartupLocation="CenterOwner"
 Closing="OnClosing" Background="#F3F7FC">
 <Grid Margin="17">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
   <StackPanel>
    <TextBlock Text="CT-12A  /  Allan 方差／随机稳定性表征" Style="{StaticResource Title}" FontSize="23"/>
    <TextBlock Text="真实IMU长时间静止采集 · 16帧FIFO批次均值的工程级重叠Allan偏差 · ACC + Gyro 六轴 · 无转台运动命令" Foreground="#587695" Margin="0,5,0,0" TextWrapping="Wrap"/>
    <TextBlock x:Name="UidText" Foreground="#2263A9" Margin="0,7,0,0" FontFamily="Consolas"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="405"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <Border Style="{StaticResource Card}" Margin="0,0,0,10">
      <StackPanel>
       <TextBlock Text="① 真实设备 / 常温校准" Style="{StaticResource Title}"/>
       <TextBlock x:Name="CalibrationText" Margin="0,9,0,0" Text="主界面选择常温标定与完整UID相匹配的ACC/Gyro JSON" TextWrapping="Wrap" FontSize="12" Foreground="#226596"/>
       <TextBlock Text="分析报告保存根目录" Margin="0,11,0,3" Foreground="#637B93"/>
       <TextBlock x:Name="RootText" TextWrapping="Wrap" Foreground="#2D679C" FontSize="12"/>
       <TextBlock Text="原始/选定FIFO CSV将保存在主界面的独立采集根目录；报告另存于上述报告根目录。" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#687E93"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,10">
      <StackPanel>
       <TextBlock Text="② 采集与Allan分析参数" Style="{StaticResource Title}"/>
       <UniformGrid Columns="2" Margin="0,11,0,0">
        <StackPanel Margin="0,0,6,8"><TextBlock Text="采集时长 (分钟)"/><TextBox x:Name="DurationMinutes" Text="120" TextChanged="SettingChanged"/></StackPanel>
        <StackPanel Margin="6,0,0,8"><TextBlock Text="最少FIFO批数"/><TextBox x:Name="MinimumBatches" Text="500" TextChanged="SettingChanged"/></StackPanel>
        <StackPanel Margin="0,0,6,8"><TextBlock Text="最小τ (秒)"/><TextBox x:Name="TauMin" Text="1" TextChanged="SettingChanged"/></StackPanel>
        <StackPanel Margin="6,0,0,8"><TextBlock Text="最大τ (秒)"/><TextBox x:Name="TauMax" Text="600" TextChanged="SettingChanged"/></StackPanel>
        <StackPanel Margin="0,0,6,8"><TextBlock Text="每十倍程曲线点数"/><TextBox x:Name="PointsPerDecade" Text="6" TextChanged="SettingChanged"/></StackPanel>
        <StackPanel Margin="6,0,0,8"><TextBlock Text="主机周期P95容差 (%)"/><TextBox x:Name="HostJitter" Text="20" TextChanged="SettingChanged"/></StackPanel>
        <StackPanel Margin="0,0,6,8"><TextBlock Text="MCU周期P95容差 (%)"/><TextBox x:Name="McuJitter" Text="20" TextChanged="SettingChanged"/></StackPanel>
        <StackPanel Margin="6,0,0,8"><TextBlock Text="FIFO跨度误差容差 (%)"/><TextBox x:Name="FifoTolerance" Text="25" TextChanged="SettingChanged"/></StackPanel>
       </UniformGrid>
       <TextBlock Text="允许温度变化范围 (°C)" Margin="0,3,0,4"/>
       <TextBox x:Name="MaxTempRange" Text="2" TextChanged="SettingChanged"/>
       <Button x:Name="PreviewButton" Content="预览本次采样及τ范围" Style="{StaticResource Action}" Click="PreviewClick" Margin="0,6,0,0"/>
       <TextBlock x:Name="PlanText" TextWrapping="Wrap" Foreground="#557591" FontSize="12" Margin="0,8,0,0"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="③ 静态环境与时间质量确认" Style="{StaticResource Title}"/>
       <CheckBox x:Name="StationaryConfirm" Content="已固定IMU与线缆，确认全程静止、无振动和机械移动" Margin="0,11,0,6"/>
       <CheckBox x:Name="ThermalConfirm" Content="已准备稳定温度环境，接受记录中如实报告温度变化" Margin="0,0,0,6"/>
       <CheckBox x:Name="TimebaseConfirm" Content="理解：MCU仅有16帧批次级时标，非逐帧硬件同步计量" Margin="0,0,0,6"/>
       <TextBlock Text="SENSOR_OK未确认时仅生成来源未核实的诊断曲线，不发布噪声系数；SIM_MODE置位、丢帧和时间质量异常仍拒绝。" Margin="0,8,0,0" Foreground="#9F6839" TextWrapping="Wrap" FontSize="12"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
     <StackPanel>
      <TextBlock Text="运行进度与数据可信度" Style="{StaticResource Title}"/>
      <TextBlock x:Name="SummaryText" Text="准备开始静态长时间采集" Foreground="#275D95" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <ProgressBar x:Name="RunProgressBar" Height="9" Margin="0,9,0,0" Minimum="0" Maximum="100" Value="0" IsIndeterminate="False"/>
      <TextBlock x:Name="StatusText" Text="未启动。所有参数可先自由编辑并预览。" Foreground="#607B96" Margin="0,7,0,0" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
    <TabControl x:Name="Tabs" Grid.Row="1">
     <TabItem Header="六轴Allan结果">
      <DataGrid x:Name="AxisGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="34">
       <DataGrid.Columns>
        <DataGridTextColumn Header="传感器轴" Binding="{Binding Axis}" Width="65"/>
        <DataGridTextColumn Header="均值" Binding="{Binding Mean}" Width="*"/>
        <DataGridTextColumn Header="标准差" Binding="{Binding Std}" Width="*"/>
        <DataGridTextColumn Header="最低ADEV" Binding="{Binding Min}" Width="*"/>
        <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="45"/>
        <DataGridTextColumn Header="τ 秒" Binding="{Binding Tau}" Width="*"/>
        <DataGridTextColumn Header="ARW / VRW" Binding="{Binding Arw}" Width="*"/>
        <DataGridTextColumn Header="Bias代理" Binding="{Binding Bias}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
     <TabItem Header="Allan偏差曲线数据">
      <DataGrid x:Name="CurveGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="32">
       <DataGrid.Columns>
        <DataGridTextColumn Header="τ (秒)" Binding="{Binding Tau}" Width="*"/>
        <DataGridTextColumn Header="Gyro-X σ" Binding="{Binding X}" Width="*"/>
        <DataGridTextColumn Header="Gyro-Y σ" Binding="{Binding Y}" Width="*"/>
        <DataGridTextColumn Header="Gyro-Z σ" Binding="{Binding Z}" Width="*"/>
        <DataGridTextColumn Header="ACC-X σ" Binding="{Binding Ax}" Width="*"/>
        <DataGridTextColumn Header="ACC-Y σ" Binding="{Binding Ay}" Width="*"/>
        <DataGridTextColumn Header="ACC-Z σ" Binding="{Binding Az}" Width="*"/>
        <DataGridTextColumn Header="重叠差分数" Binding="{Binding Differences}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
    </TabControl>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,10,0,0">
     <StackPanel>
      <TextBlock Text="质量判断与自动报告" Style="{StaticResource Title}"/>
      <TextBlock x:Name="QualityText" Text="尚未获得真实采样：时标资格待核验" Margin="0,7,0,0" Foreground="#276494" TextWrapping="Wrap"/>
      <TextBlock x:Name="ReportText" Text="采集结束自动输出 JSON、Allan CSV、质量 CSV、三表 Excel、带六轴对数曲线的 HTML。原始 FIFO CSV 另行留存。" Margin="0,6,0,0" Foreground="#688097" FontSize="12" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
   </Grid>
  </Grid>
  <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,12,0,0">
   <Button DockPanel.Dock="Right" Content="关闭" Style="{StaticResource Action}" Click="CloseClick"/>
   <Button DockPanel.Dock="Right" x:Name="OfflineButton" Content="离线重算历史CSV（免重采）" Style="{StaticResource Action}" Click="OfflineClick"/>
   <Button DockPanel.Dock="Right" x:Name="ReportButton" Content="打开图文报告" Style="{StaticResource Action}" Click="ReportClick" IsEnabled="False"/>
   <Button DockPanel.Dock="Right" x:Name="StopButton" Content="取消采集（不运动转台）" Style="{StaticResource Warning}" Click="StopClick" IsEnabled="False"/>
   <Button DockPanel.Dock="Right" x:Name="StartButton" Content="▶ 一键自动Allan采集与分析" Style="{StaticResource Primary}" Click="StartClick"/>
  </DockPanel>
 </Grid>
</Window>
