
<Window x:Class="Dts.Wpf.TestWindows.CT20.CT20Window"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="CT-20 · Gyro冷启动预热零偏稳定性" Width="1120" Height="790" MinWidth="950" MinHeight="650"
 WindowStartupLocation="CenterOwner" Background="#F3F7FC" Closing="OnClosing">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="White" CornerRadius="9" Padding="14" Margin="0,0,0,12"><StackPanel>
   <TextBlock Text="CT-20 / Gyro冷启动预热零偏稳定性" FontSize="22" FontWeight="Bold" Foreground="#173B60"/>
   <TextBlock x:Name="IdentityText" Margin="0,6,0,0"/><TextBlock x:Name="CalibrationText" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#526D86"/>
  </StackPanel></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer Grid.Column="0"><StackPanel>
    <Border Background="White" CornerRadius="9" Padding="13" Margin="0,0,0,10"><StackPanel>
     <TextBlock Text="① 冷启动与采集参数" FontSize="17" FontWeight="Bold"/>
     <TextBlock Text="人工记录的上电时间（本机时间 yyyy-MM-dd HH:mm:ss）" Margin="0,9,0,3"/><TextBox x:Name="PowerOnBox" Text="" ToolTip="填写人工记录的实际重新上电时间，例如 2026-11-12 15:30:00"/>
     <TextBlock Text="必须填写真实上电时刻；报告中的预热时间从该时刻起算，而不是从第一帧采集起算。" TextWrapping="Wrap" Foreground="#8A5A24" Margin="0,4,0,6"/>
     <TextBlock Text="单次采集时长（分钟）" Margin="0,9,0,3"/><TextBox x:Name="DurationBox" Text="30"/>
     <TextBlock Text="统计窗口（秒）" Margin="0,8,0,3"/><TextBox x:Name="WindowBox" Text="60"/>
     <TextBlock Text="连续稳定持续时间（秒）" Margin="0,8,0,3"/><TextBox x:Name="StableBox" Text="300"/>
     <TextBlock Text="XYZ零偏均值绝对值阈值（°/s）" Margin="0,8,0,3"/><TextBox x:Name="BiasBox" Text="0.02"/>
     <TextBlock Text="XYZ漂移率绝对值阈值（°/min）" Margin="0,8,0,3"/><TextBox x:Name="DriftBox" Text="0.001"/>
     <TextBlock Text="最低完整FIFO批次数" Margin="0,8,0,3"/><TextBox x:Name="BatchesBox" Text="100"/>
     <TextBlock x:Name="PlanText" TextWrapping="Wrap" Foreground="#526D86" Margin="0,12,0,0"/>
    </StackPanel></Border>
    <Border Background="White" CornerRadius="9" Padding="13"><StackPanel>
     <TextBlock Text="② 实验条件确认" FontSize="17" FontWeight="Bold"/>
     <CheckBox x:Name="ColdCheck" Content="已人工断电并完成冷启动；上电时刻可追溯" Margin="0,10,0,5"/>
     <CheckBox x:Name="StaticCheck" Content="PCB固定不动；转台静止；采集期间不触碰设备" Margin="0,3,0,5"/>
     <CheckBox x:Name="TempCheck" Content="记录芯片温度；实验室环境条件已记录" Margin="0,3,0,5"/>
     <TextBlock Text="供电由人工拔插USB/电源完成。开始采集前先完成断电/上电，随后连接主程序；本窗口不控制供电。" TextWrapping="Wrap" Foreground="#8A5A24" Margin="0,9,0,0"/>
     <TextBlock Text="建议独立冷启动至少3轮。每轮单独运行CT-20并保存报告，保持PCB装夹、室温和断电冷却时间一致。" TextWrapping="Wrap" Foreground="#526D86" Margin="0,7,0,0"/>
    </StackPanel></Border>
   </StackPanel></ScrollViewer>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="White" CornerRadius="9" Padding="13" Margin="0,0,0,10"><StackPanel>
     <TextBlock Text="测试状态" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="StatusText" Text="等待连接真实IMU及选择常温标定" Margin="0,7,0,0" TextWrapping="Wrap"/>
     <ProgressBar x:Name="ProgressBar" Height="9" Margin="0,9,0,0" IsIndeterminate="False"/>
     <TextBlock x:Name="OutputText" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="#526D86"/>
    </StackPanel></Border>
    <TabControl Grid.Row="1"><TabItem Header="预热分窗结果（时间从人工上电时刻起算）"><DataGrid x:Name="WindowGrid" AutoGenerateColumns="True" IsReadOnly="True"/></TabItem>
     <TabItem Header="判据与结论"><ScrollViewer><TextBlock x:Name="SummaryText" Margin="12" TextWrapping="Wrap"/></ScrollViewer></TabItem></TabControl>
    <Border Grid.Row="2" Background="White" CornerRadius="9" Padding="12" Margin="0,10,0,0"><TextBlock x:Name="RootText" TextWrapping="Wrap" Foreground="#526D86"/></Border>
   </Grid>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,12,0,0">
   <Button x:Name="StartButton" DockPanel.Dock="Right" Content="开始冷启动采集" Click="StartClick" Padding="13,7" Margin="6,0,0,0"/>
   <Button x:Name="StopButton" DockPanel.Dock="Right" Content="停止采集" Click="StopClick" Padding="13,7" IsEnabled="False" Margin="6,0,0,0"/>
   <Button x:Name="ReportButton" DockPanel.Dock="Right" Content="打开HTML报告" Click="ReportClick" Padding="13,7" IsEnabled="False" Margin="6,0,0,0"/>
   <Button Content="关闭" Click="CloseClick" Padding="13,7"/>
  </DockPanel>
 </Grid>
</Window>
