<Window x:Class="Dts.Wpf.TestWindows.CT07.CT07Window"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="CT-07 · 同姿态测量重复性 · 全自动测试" Width="1220" Height="835"
 MinWidth="1030" MinHeight="700" WindowStartupLocation="CenterOwner"
 Closing="OnClosing" Background="#F3F7FC">
 <Grid Margin="17">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
   <StackPanel>
    <TextBlock Text="CT-07  /  同姿态测量重复性" Style="{StaticResource Title}" FontSize="23"/>
    <TextBlock Text="同一个目标姿态：自动离位 → 自动回位 → 等待静止 → 真实六轴采样 · 区分跨轮重复性与轮内噪声" Foreground="#587695" Margin="0,5,0,0" TextWrapping="Wrap"/>
    <TextBlock x:Name="UidText" Foreground="#2263A9" Margin="0,7,0,0" FontFamily="Consolas"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="382"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <Border Style="{StaticResource Card}" Margin="0,0,0,10">
      <StackPanel>
       <TextBlock Text="① 常温模型和设备身份" Style="{StaticResource Title}"/>
       <TextBlock Text="主窗口须选择常温标定；ACC/Gyro均由完整UID匹配，按原JSON拟合输入量程换算，不修改标定文件。" TextWrapping="Wrap" Foreground="#677F97" Margin="0,7,0,4"/>
       <TextBlock x:Name="CalibrationText" Text="等待主窗口传入常温模型" TextWrapping="Wrap" Foreground="#205F96" FontSize="12"/>
       <TextBlock Text="报告输出根目录" Foreground="#698099" Margin="0,8,0,3"/>
       <TextBlock x:Name="RootText" Foreground="#285886" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,10">
      <StackPanel>
       <TextBlock Text="② 同姿态往返扫描参数" Style="{StaticResource Title}"/>
       <TextBlock Text="每轮先离开目标，再回到相同的内外轴目标角；下列角度均为绝对角度。" TextWrapping="Wrap" Foreground="#637B93" FontSize="12" Margin="0,7,0,4"/>
       <UniformGrid Columns="2" Margin="0,9,0,0">
        <StackPanel Margin="0,0,6,8"><TextBlock Text="内轴目标 (°)"/><TextBox x:Name="InnerTarget" Text="90" TextChanged="GridSettingChanged"/></StackPanel>
        <StackPanel Margin="6,0,0,8"><TextBlock Text="外轴目标 (°)"/><TextBox x:Name="OuterTarget" Text="90" TextChanged="GridSettingChanged"/></StackPanel>
        <StackPanel Margin="0,0,6,8"><TextBlock Text="内轴离开幅度 (°)"/><TextBox x:Name="InnerDelta" Text="10" TextChanged="GridSettingChanged"/></StackPanel>
        <StackPanel Margin="6,0,0,8"><TextBlock Text="外轴离开幅度 (°)"/><TextBox x:Name="OuterDelta" Text="10" TextChanged="GridSettingChanged"/></StackPanel>
        <StackPanel Margin="0,0,6,8"><TextBlock Text="往返次数 (3~40)"/><TextBox x:Name="RepeatCount" Text="6" TextChanged="GridSettingChanged"/></StackPanel>
        <StackPanel Margin="6,0,0,8"><TextBlock Text="速度 (°/s)"/><TextBox x:Name="MotionSpeed" Text="1"/></StackPanel>
        <StackPanel Margin="0,0,6,8"><TextBlock Text="静置 (s)"/><TextBox x:Name="SettleSeconds" Text="3"/></StackPanel>
        <StackPanel Margin="6,0,0,8"><TextBlock Text="每轮采集 (s)"/><TextBox x:Name="CaptureSeconds" Text="5"/></StackPanel>
        <StackPanel Margin="0,0,6,8"><TextBlock Text="到位容差 (°)"/><TextBox x:Name="Tolerance" Text="0.10"/></StackPanel>
        <StackPanel Margin="6,0,0,8"><TextBlock Text="最少有效帧"/><TextBox x:Name="MinSamples" Text="100"/></StackPanel>
        <StackPanel Margin="0,0,6,8"><TextBlock Text="允许行程下界 (°)"/><TextBox x:Name="MinTravel" Text="0"/></StackPanel>
        <StackPanel Margin="6,0,0,8"><TextBlock Text="允许行程上界 (°)"/><TextBox x:Name="MaxTravel" Text="180"/></StackPanel>
       </UniformGrid>
       <TextBlock Text="最大帧剔除比例 (0~0.30)"/>
       <TextBox x:Name="MaxRejection" Text="0.15" Margin="0,4,0,7"/>
       <CheckBox x:Name="AlternateApproach" Content="交替从正、负两侧回到目标（测试回位方向影响）" IsChecked="True" Margin="0,7,0,4" Checked="GridCheckChanged" Unchecked="GridCheckChanged"/>
       <Button x:Name="PreviewButton" Content="预览并检查全部往返动作" Style="{StaticResource Action}" Click="PreviewClick" Margin="0,6,0,0"/>
       <TextBlock x:Name="PlanSummary" TextWrapping="Wrap" Foreground="#59728C" FontSize="12" Margin="0,7,0,0"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="③ 真实设备运动安全" Style="{StaticResource Title}"/>
       <CheckBox x:Name="DirectionConfirmed" Content="已核验绝对角度路径、旋向、工装、线缆与限位" Margin="0,9,0,7"/>
       <CheckBox x:Name="SafetyConfirmed" Content="实体急停可用；人员在现场监护且运动区域无障碍" Margin="0,0,0,5"/>
       <TextBlock Text="测试需要内轴运动时，按现有安全路径先将外轴停在0°。软件软停车无法取代现场实体急停。" TextWrapping="Wrap" Foreground="#9A6B36" FontSize="12" Margin="0,7,0,0"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
     <StackPanel>
      <TextBlock Text="自动重复回位预览" Style="{StaticResource Title}"/>
      <TextBlock Text="每轮目标姿态完全相同；数据分析分别报告测量向量、转台回位反馈和温度变化。" Foreground="#647D93" TextWrapping="Wrap" Margin="0,5,0,0"/>
      <TextBlock x:Name="SummaryText" Text="准备就绪" Foreground="#235F97" FontWeight="SemiBold" Margin="0,9,0,0" TextWrapping="Wrap"/>
      <ProgressBar x:Name="RunProgressBar" Height="8" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="0"/>
      <TextBlock x:Name="StatusText" Text="等待现场确认" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#597591"/>
     </StackPanel>
    </Border>
    <TabControl x:Name="ResultTabs" Grid.Row="1">
     <TabItem Header="往返扫描计划">
      <DataGrid x:Name="PlanGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="32">
       <DataGrid.Columns>
        <DataGridTextColumn Header="轮次" Binding="{Binding Index}" Width="58"/>
        <DataGridTextColumn Header="离开内轴°" Binding="{Binding InnerDepartDeg, StringFormat=F2}" Width="*"/>
        <DataGridTextColumn Header="离开外轴°" Binding="{Binding OuterDepartDeg, StringFormat=F2}" Width="*"/>
        <DataGridTextColumn Header="返回内轴°" Binding="{Binding InnerReturnDeg, StringFormat=F2}" Width="*"/>
        <DataGridTextColumn Header="返回外轴°" Binding="{Binding OuterReturnDeg, StringFormat=F2}" Width="*"/>
        <DataGridTextColumn Header="返回方式" Binding="{Binding Approach}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
     <TabItem Header="真实各轮测量结果">
      <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="32">
       <DataGrid.Columns>
        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40"/>
        <DataGridTextColumn Header="内轴反馈°" Binding="{Binding Inner}" Width="85"/>
        <DataGridTextColumn Header="外轴反馈°" Binding="{Binding Outer}" Width="85"/>
        <DataGridTextColumn Header="ACC X g" Binding="{Binding Ax}" Width="83"/>
        <DataGridTextColumn Header="ACC Y g" Binding="{Binding Ay}" Width="83"/>
        <DataGridTextColumn Header="ACC Z g" Binding="{Binding Az}" Width="83"/>
        <DataGridTextColumn Header="矢量误差 mg" Binding="{Binding ErrorMg}" Width="99"/>
        <DataGridTextColumn Header="有效帧" Binding="{Binding Samples}" Width="65"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
    </TabControl>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0">
     <StackPanel>
      <TextBlock Text="统计和报告" Style="{StaticResource Title}"/>
      <TextBlock x:Name="MetricsText" Text="等待真实实测；不自动判断PASS" Foreground="#28659A" TextWrapping="Wrap" Margin="0,6,0,0"/>
      <TextBlock x:Name="ReportText" Text="自动归档逐轮物理量/校正六轴CSV、逐轮结果、JSON、Excel、带三张SVG图的HTML。" TextWrapping="Wrap" Foreground="#63798D" FontSize="12" Margin="0,5,0,0"/>
     </StackPanel>
    </Border>
   </Grid>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
   <Button DockPanel.Dock="Right" x:Name="CloseButton" Content="关闭" Style="{StaticResource Action}" Click="CloseClick"/>
   <Button DockPanel.Dock="Right" x:Name="ReportButton" Content="查看图文报告" Style="{StaticResource Action}" Click="ReportClick" IsEnabled="False"/>
   <Button DockPanel.Dock="Right" x:Name="StopButton" Content="取消 / 双轴软停车" Style="{StaticResource Warning}" Click="StopClick" IsEnabled="False"/>
   <Button DockPanel.Dock="Right" x:Name="StartButton" Content="▶ 一键自动重复性测试" Style="{StaticResource Primary}" Click="StartClick"/>
  </DockPanel>
 </Grid>
</Window>
