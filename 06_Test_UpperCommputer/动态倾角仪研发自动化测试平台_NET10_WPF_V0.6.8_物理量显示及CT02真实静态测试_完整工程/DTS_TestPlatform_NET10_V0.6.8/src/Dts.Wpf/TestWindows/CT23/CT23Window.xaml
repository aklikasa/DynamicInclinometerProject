<Window x:Class="Dts.Wpf.TestWindows.CT23.CT23Window"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="CT-23 · ACC↔Gyro 联合对齐 · 重力闭合诊断" Width="1230" Height="835"
 MinWidth="1020" MinHeight="690" WindowStartupLocation="CenterOwner"
 Closing="OnClosing" Background="#F3F7FC">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
   <StackPanel>
    <TextBlock Text="CT-23 / ACC↔Gyro 六轴联合对齐" Style="{StaticResource Title}" FontSize="22"/>
    <TextBlock Text="倾斜初始姿态 → 外轴真实旋转 → Gyro三轴姿态传播 → 停车ACC重力闭合；仅单驱动轴可观测子项，不宣称完整3D轴系标定" Foreground="#55728F" Margin="0,5,0,0" TextWrapping="Wrap"/>
    <TextBlock x:Name="UidText" Foreground="#236399" Margin="0,6,0,0" FontFamily="Consolas"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <Border Style="{StaticResource Card}" Margin="0,0,0,10">
      <StackPanel>
       <TextBlock Text="① 真实设备与常温模型" Style="{StaticResource Title}"/>
       <TextBlock x:Name="CalibrationText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#315F8D" FontSize="12"/>
       <TextBlock x:Name="DynamicText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#8B5F25" FontSize="12"/>
       <TextBlock Text="报告根目录" Margin="0,7,0,3" Foreground="#667B93"/>
       <TextBlock x:Name="RootText" Foreground="#315F8D" TextWrapping="Wrap" FontSize="12"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,10">
      <StackPanel>
       <TextBlock Text="② 外轴已知角旋转轨迹（可修改）" Style="{StaticResource Title}"/>
       <TextBlock Text="用 起始角:终止角;起始角:终止角 输入不同倾斜初态。每条必须有真实重力方向变化。当前CT-10桥接器要求内轴固定0°。" Foreground="#657C94" TextWrapping="Wrap" Margin="0,8,0,6" FontSize="12"/>
       <TextBlock Text="轨迹列表（°，至少2条）"/>
       <TextBox x:Name="TrajectoryInput" Text="50:100;75:125;120:60" TextChanged="PlanSettingChanged" Margin="0,4,0,8"/>
       <UniformGrid Columns="2">
        <StackPanel Margin="0,0,6,8"><TextBlock Text="动态速度 (°/s)"/><TextBox x:Name="SpeedInput" Text="1" TextChanged="PlanSettingChanged"/></StackPanel>
        <StackPanel Margin="6,0,0,8"><TextBlock Text="定位速度 (°/s)"/><TextBox x:Name="SetupSpeedInput" Text="1"/></StackPanel>
        <StackPanel Margin="0,0,6,8"><TextBlock Text="每条路径重复次数"/><TextBox x:Name="RepeatsInput" Text="1" TextChanged="PlanSettingChanged"/></StackPanel>
        <StackPanel Margin="6,0,0,8"><TextBlock Text="到位后静置 (s)"/><TextBox x:Name="SettleInput" Text="3"/></StackPanel>
        <StackPanel Margin="0,0,6,8"><TextBlock Text="每次静态采样 (s)"/><TextBox x:Name="StaticDurationInput" Text="4"/></StackPanel>
        <StackPanel Margin="6,0,0,8"><TextBlock Text="静态最少有效帧"/><TextBox x:Name="MinStaticInput" Text="100"/></StackPanel>
        <StackPanel Margin="0,0,6,8"><TextBlock Text="动态最少真实帧"/><TextBox x:Name="MinDynamicInput" Text="20"/></StackPanel>
        <StackPanel Margin="6,0,0,8"><TextBlock Text="到位容差 (°)"/><TextBox x:Name="PositionToleranceInput" Text="0.15"/></StackPanel>
        <StackPanel Margin="0,0,6,8"><TextBlock Text="允许角度下界 (°)"/><TextBox x:Name="TravelMinInput" Text="0"/></StackPanel>
        <StackPanel Margin="6,0,0,8"><TextBlock Text="允许角度上界 (°)"/><TextBox x:Name="TravelMaxInput" Text="180"/></StackPanel>
        <StackPanel Margin="0,0,6,8"><TextBlock Text="Gyro最大帧间隔 (s)"/><TextBox x:Name="MaxGapInput" Text="0.5"/></StackPanel>
        <StackPanel Margin="6,0,0,8"><TextBlock Text="起止同步容许差 (s)"/><TextBox x:Name="MaxSkewInput" Text="0.35"/></StackPanel>
       </UniformGrid>
       <TextBlock Text="Gyro X积分角与编码器差异的保护阈值 (°)" TextWrapping="Wrap"/>
       <TextBox x:Name="AngleMismatchInput" Text="12" Margin="0,4,0,8"/>
       <Button x:Name="PreviewButton" Content="预览全部自动测试路径" Click="PreviewClick" Style="{StaticResource Action}" Margin="0,4,0,0"/>
       <TextBlock x:Name="PlanSummary" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#617991" FontSize="12"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="③ 现场运动安全确认" Style="{StaticResource Title}"/>
       <CheckBox x:Name="AxesCheck" Content="已核验ACC、Gyro与转台坐标轴正负方向一致" Margin="0,10,0,7"/>
       <CheckBox x:Name="SafetyCheck" Content="确认所有路径、线缆、工装和真实限位安全" Margin="0,0,0,7"/>
       <CheckBox x:Name="StopCheck" Content="实体急停可用，现场有人员持续监护" Margin="0,0,0,7"/>
       <TextBlock Text="仅允许通过真实CT-10动态桥接器启动；软件软停车不是硬件急停。没有完成动态接口验证时可预览但不允许启动。" Foreground="#966827" TextWrapping="Wrap" FontSize="12"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
     <StackPanel>
      <TextBlock Text="轨迹与完成进度" Style="{StaticResource Title}"/>
      <TextBlock x:Name="SummaryText" Text="独立参数预览可用；未执行真实测试" Foreground="#23649A" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <ProgressBar x:Name="RunProgressBar" Minimum="0" Maximum="100" Height="9" Margin="0,9,0,0"/>
      <TextBlock x:Name="StatusText" Text="待参数确认" Foreground="#667B94" Margin="0,6,0,0" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
    <TabControl x:Name="ResultTabs" Grid.Row="1">
     <TabItem Header="扫描计划">
      <DataGrid x:Name="PlanGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="30">
       <DataGrid.Columns>
        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50"/>
        <DataGridTextColumn Header="路径" Binding="{Binding TrajectoryIndex}" Width="60"/>
        <DataGridTextColumn Header="重复" Binding="{Binding Repetition}" Width="60"/>
        <DataGridTextColumn Header="外轴起点°" Binding="{Binding OuterStartDeg, StringFormat=F2}" Width="*"/>
        <DataGridTextColumn Header="外轴终点°" Binding="{Binding OuterEndDeg, StringFormat=F2}" Width="*"/>
        <DataGridTextColumn Header="速度°/s" Binding="{Binding SpeedDps, StringFormat=F2}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
     <TabItem Header="实测结果">
      <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="30">
       <DataGrid.Columns>
        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="45"/>
        <DataGridTextColumn Header="起点°" Binding="{Binding From}" Width="*"/>
        <DataGridTextColumn Header="终点°" Binding="{Binding To}" Width="*"/>
        <DataGridTextColumn Header="闭合误差°" Binding="{Binding Closure}" Width="*"/>
        <DataGridTextColumn Header="Gyro累计°" Binding="{Binding Gyro}" Width="*"/>
        <DataGridTextColumn Header="真实运动°" Binding="{Binding Encoder}" Width="*"/>
        <DataGridTextColumn Header="动态帧" Binding="{Binding Samples}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
    </TabControl>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0">
     <StackPanel>
      <TextBlock Text="诊断结果与报告" Style="{StaticResource Title}"/>
      <TextBlock x:Name="MetricsText" Text="待真实采样；只报告单轴闭合，完整3D轴系尚不可观测。" Foreground="#27639B" TextWrapping="Wrap" Margin="0,7,0,0"/>
      <TextBlock x:Name="ReportText" Text="已设计 JSON、CSV、Excel、HTML；每条轨迹保存静止前/后ACC+Gyro原始记录、动态Gyro逐帧和编码器数据。" Foreground="#647B93" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
   </Grid>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
   <Button DockPanel.Dock="Right" Content="关闭" Click="CloseClick" Style="{StaticResource Action}"/>
   <Button DockPanel.Dock="Right" x:Name="ReportButton" Content="查看图文报告" Click="ReportClick" Style="{StaticResource Action}" IsEnabled="False"/>
   <Button DockPanel.Dock="Right" x:Name="StopButton" Content="取消 / 双轴软停车" Click="StopClick" Style="{StaticResource Warning}" IsEnabled="False"/>
   <Button DockPanel.Dock="Right" x:Name="StartButton" Content="▶ 一键运行实测诊断" Click="StartClick" Style="{StaticResource Primary}"/>
  </DockPanel>
 </Grid>
</Window>
