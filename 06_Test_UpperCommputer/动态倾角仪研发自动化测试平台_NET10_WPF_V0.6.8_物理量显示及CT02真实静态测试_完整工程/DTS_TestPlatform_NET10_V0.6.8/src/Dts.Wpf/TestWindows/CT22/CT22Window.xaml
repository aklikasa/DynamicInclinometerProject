<Window x:Class="Dts.Wpf.TestWindows.CT22.CT22Window"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="CT-22 · Gyro 静止积分漂移" Width="1220" Height="815"
 MinWidth="1000" MinHeight="660" WindowStartupLocation="CenterOwner"
 Closing="OnClosing" Background="#F3F7FC">
 <Grid Margin="17">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
   <StackPanel>
    <TextBlock Text="CT-22  /  Gyro 静止积分漂移" Style="{StaticResource Title}" FontSize="23"/>
    <TextBlock Text="真实IMU连续静止采集 · 三轴未融合积分 · 10/30min检查点 · MCU批次真实Δt · 无转台运动" Foreground="#5B7995" TextWrapping="Wrap" Margin="0,6,0,0"/>
    <TextBlock x:Name="UidText" Foreground="#225D95" FontFamily="Consolas" Margin="0,7,0,0"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="395"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <Border Style="{StaticResource Card}" Margin="0,0,0,11">
      <StackPanel>
       <TextBlock Text="① 真实设备与校准" Style="{StaticResource Title}"/>
       <TextBlock x:Name="CalibrationText" Text="主窗口选择常温补偿ACC/Gyro、完整UID核验" Margin="0,9,0,0" TextWrapping="Wrap" Foreground="#24659A" FontSize="12"/>
       <TextBlock Text="报告输出根目录" Margin="0,10,0,5"/>
       <TextBlock x:Name="RootText" TextWrapping="Wrap" Foreground="#557B9F" FontSize="12"/>
       <TextBlock Text="原始采集保存到平台原始采集根目录，分析报告另存于报告根目录。" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#69849B" FontSize="12"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,11">
      <StackPanel>
       <TextBlock Text="② 静态积分参数（都可修改）" Style="{StaticResource Title}"/>
       <UniformGrid Columns="2" Margin="0,10,0,0">
        <StackPanel Margin="0,0,7,8"><TextBlock Text="采集时长 (分钟)"/><TextBox x:Name="DurationMinutes" Text="31" TextChanged="SettingChanged"/></StackPanel>
        <StackPanel Margin="7,0,0,8"><TextBlock Text="最少完整FIFO批数"/><TextBox x:Name="MinimumBatches" Text="500" TextChanged="SettingChanged"/></StackPanel>
        <StackPanel Margin="0,0,7,8"><TextBlock Text="主机周期P95容差 (%)"/><TextBox x:Name="HostJitter" Text="20" TextChanged="SettingChanged"/></StackPanel>
        <StackPanel Margin="7,0,0,8"><TextBlock Text="MCU周期P95容差 (%)"/><TextBox x:Name="McuJitter" Text="20" TextChanged="SettingChanged"/></StackPanel>
        <StackPanel Margin="0,0,7,8"><TextBlock Text="FIFO 16帧跨度容差 (%)"/><TextBox x:Name="FifoSpan" Text="25" TextChanged="SettingChanged"/></StackPanel>
        <StackPanel Margin="7,0,0,8"><TextBlock Text="主机/MCU总时长差容差 (%)"/><TextBox x:Name="ClockMismatch" Text="5" TextChanged="SettingChanged"/></StackPanel>
        <StackPanel Margin="0,0,7,8"><TextBlock Text="允许温度变化 (°C)"/><TextBox x:Name="TempRange" Text="2" TextChanged="SettingChanged"/></StackPanel>
        <StackPanel Margin="7,0,0,8"><TextBlock Text="ACC方向变化上限 (°)"/><TextBox x:Name="AccAngle" Text="0.3" TextChanged="SettingChanged"/></StackPanel>
       </UniformGrid>
       <TextBlock Text="积分曲线输出间隔 (秒)" Margin="0,1,0,4"/>
       <TextBox x:Name="PlotInterval" Text="1" TextChanged="SettingChanged"/>
       <Button x:Name="PreviewButton" Content="预览采样与10/30分钟检查点" Style="{StaticResource Action}" Click="PreviewClick" Margin="0,9,0,0"/>
       <TextBlock x:Name="PlanText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#537694" FontSize="12"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="③ 全程静止与时间质量确认" Style="{StaticResource Title}"/>
       <CheckBox x:Name="StationaryConfirm" Content="确认IMU、线缆和工装固定，全程不移动转台" Margin="0,10,0,7"/>
       <CheckBox x:Name="ThermalConfirm" Content="确认环境温度可记录，接受真实温漂分析" Margin="0,0,0,7"/>
       <CheckBox x:Name="TimebaseConfirm" Content="理解：16帧仅有批次时间戳，并非逐帧计量时标" Margin="0,0,0,7"/>
       <TextBlock Text="不会发送任何转台运动命令；不重新扣除测试期间的Gyro均值。若时标或静止证据不合格，只保存真实采集和问题报告。" Foreground="#A06B38" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,0"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
     <StackPanel>
      <TextBlock Text="真实采集进度与任务状态" Style="{StaticResource Title}"/>
      <TextBlock x:Name="SummaryText" Text="可先设置任意时长并预览；不连接设备也不会隐藏计划。" TextWrapping="Wrap" Foreground="#286499" FontWeight="SemiBold" Margin="0,7,0,0"/>
      <ProgressBar x:Name="RunProgressBar" Height="8" Margin="0,10,0,0" IsIndeterminate="False"/>
      <TextBlock x:Name="StatusText" Text="等待参数与静止确认" Foreground="#65809C" TextWrapping="Wrap" Margin="0,6,0,0"/>
     </StackPanel>
    </Border>
    <TabControl x:Name="Tabs" Grid.Row="1">
     <TabItem Header="三轴积分漂移结果">
      <DataGrid x:Name="AxisGrid" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False" RowHeight="36">
       <DataGrid.Columns>
        <DataGridTextColumn Header="轴" Binding="{Binding Axis}" Width="70"/>
        <DataGridTextColumn Header="10分钟 °" Binding="{Binding Min10}" Width="*"/>
        <DataGridTextColumn Header="30分钟 °" Binding="{Binding Min30}" Width="*"/>
        <DataGridTextColumn Header="末端角度 °" Binding="{Binding Last}" Width="*"/>
        <DataGridTextColumn Header="最大绝对 °" Binding="{Binding Peak}" Width="*"/>
        <DataGridTextColumn Header="斜率 °/min" Binding="{Binding Slope}" Width="*"/>
        <DataGridTextColumn Header="均值 °/s" Binding="{Binding Rate}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
     <TabItem Header="积分曲线数据">
      <DataGrid x:Name="CurveGrid" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False" RowHeight="30">
       <DataGrid.Columns>
        <DataGridTextColumn Header="MCU秒" Binding="{Binding T}" Width="*"/>
        <DataGridTextColumn Header="Gyro-X °" Binding="{Binding X}" Width="*"/>
        <DataGridTextColumn Header="Gyro-Y °" Binding="{Binding Y}" Width="*"/>
        <DataGridTextColumn Header="Gyro-Z °" Binding="{Binding Z}" Width="*"/>
        <DataGridTextColumn Header="温度 °C" Binding="{Binding Temp}" Width="*"/>
        <DataGridTextColumn Header="ACC方向偏差 °" Binding="{Binding Acc}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
    </TabControl>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,10,0,0">
     <StackPanel>
      <TextBlock Text="数据资格及报告" Style="{StaticResource Title}"/>
      <TextBlock x:Name="QualityText" Text="未采集，积分指标不可发布" TextWrapping="Wrap" Foreground="#266398" Margin="0,7,0,0"/>
      <TextBlock x:Name="ReportText" Text="结束自动生成 JSON、三份CSV、Excel、带三轴积分曲线的HTML，原始FIFO另存。" TextWrapping="Wrap" Foreground="#66829B" FontSize="12" Margin="0,6,0,0"/>
     </StackPanel>
    </Border>
   </Grid>
  </Grid>
  <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,12,0,0">
   <Button DockPanel.Dock="Right" Content="关闭" Style="{StaticResource Action}" Click="CloseClick"/>
   <Button DockPanel.Dock="Right" x:Name="ReportButton" Content="打开图文报告" Style="{StaticResource Action}" Click="ReportClick" IsEnabled="False"/>
   <Button DockPanel.Dock="Right" x:Name="StopButton" Content="取消静态采集" Style="{StaticResource Warning}" Click="StopClick" IsEnabled="False"/>
   <Button DockPanel.Dock="Right" x:Name="StartButton" Content="▶ 一键真实静止积分测试" Style="{StaticResource Primary}" Click="StartClick"/>
  </DockPanel>
 </Grid>
</Window>
