<Window x:Class="Dts.Wpf.TestWindows.CT03.CT03Window"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="CT-03 · ACC 三轴矢量独立验证 · 自动检测"
 Width="1200" Height="820" MinWidth="1020" MinHeight="690"
 WindowStartupLocation="CenterOwner" Closing="OnClosing"
 Background="#F3F7FC">
 <Grid Margin="17">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
   <StackPanel>
    <TextBlock Text="CT-03  /  ACC 三轴矢量独立验证" Style="{StaticResource Title}" FontSize="23"/>
    <TextBlock Text="真实 2TD-600 自动扫描  ·  独立非标定姿态  ·  Python P系参考矢量  ·  原始采集与逐帧校正留痕" Foreground="#567391" Margin="0,5,0,0" TextWrapping="Wrap"/>
    <TextBlock x:Name="UidText" FontFamily="Consolas" Foreground="#2263A9" Margin="0,7,0,0"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="380"/>
    <ColumnDefinition Width="12"/>
    <ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>
   <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <Border Style="{StaticResource Card}" Margin="0,0,0,10">
      <StackPanel>
       <TextBlock Text="① 校准身份与数据源" Style="{StaticResource Title}"/>
       <TextBlock Text="必须先在主窗口选择“常温标定”。ACC/Gyro JSON 均按UID自动匹配；只使用现有校正模型，不重新拟合。" TextWrapping="Wrap" Foreground="#607A96" Margin="0,8,0,4"/>
       <TextBlock x:Name="CalibrationText" Text="等待常温校准信息" TextWrapping="Wrap" Foreground="#24659D" FontSize="12"/>
       <TextBlock Text="报告根目录" Margin="0,9,0,3" Foreground="#698099"/>
       <TextBlock x:Name="RootText" TextWrapping="Wrap" Foreground="#285886" FontSize="12"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,10">
      <StackPanel>
       <TextBlock Text="② 自动扫描方案" Style="{StaticResource Title}"/>
       <TextBlock Text="检测范围" Margin="0,9,0,3"/>
       <ComboBox x:Name="PlanBox" SelectionChanged="PlanChanged" SelectedIndex="0">
        <ComboBoxItem Content="局部12点(0~90°)"/>
        <ComboBoxItem Content="全向24点(0~360°)"/>
        <ComboBoxItem Content="自定义360°等分网格"/>
       </ComboBox>
       <TextBlock x:Name="PlanSummary" TextWrapping="Wrap" Foreground="#607A96" FontSize="12" Margin="0,6,0,0"/>
       <StackPanel x:Name="CustomGridPanel" Visibility="Collapsed" Margin="0,9,0,5">
        <Border Background="#EEF5FD" CornerRadius="7" Padding="10">
         <StackPanel>
          <TextBlock Text="自定义等分扫描 · 内轴 N × 外轴 M" FontWeight="SemiBold" Foreground="#245C93"/>
          <UniformGrid Columns="2" Margin="0,7,0,0">
           <StackPanel Margin="0,0,6,7">
            <TextBlock Text="内轴等分数 N (2~12)"/>
            <TextBox x:Name="InnerDivisionsBox" Text="6" TextChanged="GridSettingsChanged"/>
           </StackPanel>
           <StackPanel Margin="6,0,0,7">
            <TextBlock Text="外轴等分数 M (2~12)"/>
            <TextBox x:Name="OuterDivisionsBox" Text="6" TextChanged="GridSettingsChanged"/>
           </StackPanel>
           <StackPanel Margin="0,0,6,7">
            <TextBlock Text="内轴起始角 (°)"/>
            <TextBox x:Name="InnerStartBox" Text="0" TextChanged="GridSettingsChanged"/>
           </StackPanel>
           <StackPanel Margin="6,0,0,7">
            <TextBlock Text="外轴起始角 (°)"/>
            <TextBox x:Name="OuterStartBox" Text="0" TextChanged="GridSettingsChanged"/>
           </StackPanel>
          </UniformGrid>
          <TextBlock Text="每轴以360°/等分数生成目标，不重复360°终点；起始角可偏移以减少参考重力方向重叠。" TextWrapping="Wrap" FontSize="11" Foreground="#5B7691"/>
         </StackPanel>
        </Border>
       </StackPanel>
       <UniformGrid Columns="2" Margin="0,9,0,0">
        <StackPanel Margin="0,0,6,7">
         <TextBlock Text="扫描速度 (°/s)"/>
         <TextBox x:Name="MotionSpeed" Text="1"/>
        </StackPanel>
        <StackPanel Margin="6,0,0,7">
         <TextBlock Text="静置时间 (s)"/>
         <TextBox x:Name="SettleSeconds" Text="3"/>
        </StackPanel>
        <StackPanel Margin="0,0,6,7">
         <TextBlock Text="逐点采样 (s)"/>
         <TextBox x:Name="CaptureSeconds" Text="5"/>
        </StackPanel>
        <StackPanel Margin="6,0,0,7">
         <TextBlock Text="到位容差 (°)"/>
         <TextBox x:Name="Tolerance" Text="0.10"/>
        </StackPanel>
        <StackPanel Margin="0,0,6,7">
         <TextBlock Text="行程下界 (°)"/>
         <TextBox x:Name="MinTravel" Text="0"/>
        </StackPanel>
        <StackPanel Margin="6,0,0,7">
         <TextBlock Text="行程上界 (°)"/>
         <TextBox x:Name="MaxTravel" Text="90"/>
        </StackPanel>
        <StackPanel Margin="0,0,6,7">
         <TextBlock Text="最少有效帧"/>
         <TextBox x:Name="MinSamples" Text="100"/>
        </StackPanel>
        <StackPanel Margin="6,0,0,7">
         <TextBlock Text="最大剔除比 (0~0.3)"/>
         <TextBox x:Name="MaxRejection" Text="0.15"/>
        </StackPanel>
       </UniformGrid>
       <Button x:Name="PreviewButton" Content="预览并检查扫描计划" Style="{StaticResource Action}" Click="PreviewClick" Margin="0,4,0,0" HorizontalAlignment="Stretch"/>
       <TextBlock Text="局部12点为有限范围验证；全向24点和自定义360°网格需额外批准行程。注意：36个机械工位不一定有36个独立重力方向。" TextWrapping="Wrap" FontSize="12" Foreground="#967443" Margin="0,6,0,0"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="③ 现场安全与执行确认" Style="{StaticResource Title}"/>
       <CheckBox x:Name="SafetyConfirmed" Margin="0,9,0,8">
        <TextBlock Text="夹具固定、实体急停可用、行程及限位安全已现场确认" TextWrapping="Wrap"/>
       </CheckBox>
       <CheckBox x:Name="DirectionConfirmed" Margin="0,0,0,8">
        <TextBlock Text="实际绝对定位方向与线缆绕转安全已验证；测试期间不进行手动控制" TextWrapping="Wrap"/>
       </CheckBox>
       <CheckBox x:Name="FullRangeConfirmed" Margin="0,0,0,9">
        <TextBlock Text="已额外批准全向24点/自定义360°网格涉及的全圈行程与线缆运动（仅这些方案需要）" TextWrapping="Wrap"/>
       </CheckBox>
       <TextBlock Text="点击开始后自动执行整套点位，不会要求逐点确认。点击取消可请求双轴软停车；实体急停始终需现场可操作。" TextWrapping="Wrap" FontSize="12" Foreground="#A06F48"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12">
     <StackPanel>
      <TextBlock Text="真实自动测试进度" Style="{StaticResource Title}"/>
      <ProgressBar x:Name="RunProgressBar" Margin="0,8,0,6" Height="10" Minimum="0" Maximum="100" Value="0"/>
      <TextBlock x:Name="StatusText" Text="等待设备与参数确认" TextWrapping="Wrap" Foreground="#25629D"/>
      <TextBlock x:Name="SummaryText" Text="完成后显示三轴矢量验证统计（研发结果，不自动判PASS）" TextWrapping="Wrap" Foreground="#5B7691" Margin="0,6,0,0"/>
     </StackPanel>
    </Border>
    <TabControl x:Name="ResultTabs" Grid.Row="1" Margin="0,0,0,10">
     <TabItem Header="自动扫描姿态">
      <DataGrid x:Name="PlanGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="31">
       <DataGrid.Columns>
        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="52"/>
        <DataGridTextColumn Header="内轴目标(°)" Binding="{Binding InnerTargetDeg, StringFormat=F2}" Width="*"/>
        <DataGridTextColumn Header="外轴目标(°)" Binding="{Binding OuterTargetDeg, StringFormat=F2}" Width="*"/>
        <DataGridTextColumn Header="点位编号" Binding="{Binding Label}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
     <TabItem Header="测量结果 / 三轴误差">
      <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="31">
       <DataGrid.Columns>
        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="45"/>
        <DataGridTextColumn Header="内轴°" Binding="{Binding Inner}" Width="75"/>
        <DataGridTextColumn Header="外轴°" Binding="{Binding Outer}" Width="75"/>
        <DataGridTextColumn Header="X误差 mg" Binding="{Binding ErrorX}" Width="90"/>
        <DataGridTextColumn Header="Y误差 mg" Binding="{Binding ErrorY}" Width="90"/>
        <DataGridTextColumn Header="Z误差 mg" Binding="{Binding ErrorZ}" Width="90"/>
        <DataGridTextColumn Header="矢量 mg" Binding="{Binding VectorMg}" Width="85"/>
        <DataGridTextColumn Header="方向°" Binding="{Binding Angle}" Width="80"/>
        <DataGridTextColumn Header="有效帧" Binding="{Binding Samples}" Width="70"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
    </TabControl>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
     <StackPanel>
      <TextBlock Text="报告与数据证据" Style="{StaticResource Title}"/>
      <TextBlock x:Name="MetricsText" Text="统计：等待实测" Foreground="#275F96" TextWrapping="Wrap" Margin="0,6,0,0"/>
      <TextBlock x:Name="ReportText" Text="自动保存每点 physical.csv / corrected.csv，以及 JSON、HTML图表和Excel报告" TextWrapping="Wrap" Foreground="#637A93" Margin="0,5,0,0" FontSize="12"/>
     </StackPanel>
    </Border>
   </Grid>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
   <Button DockPanel.Dock="Right" x:Name="CloseButton" Content="关闭" Style="{StaticResource Action}" Click="CloseClick"/>
   <Button DockPanel.Dock="Right" x:Name="ReportButton" Content="打开 HTML 图文报告" Style="{StaticResource Action}" Click="ReportClick" IsEnabled="False"/>
   <Button DockPanel.Dock="Right" x:Name="StopButton" Content="取消 / 双轴软停车" Style="{StaticResource Warning}" Click="StopClick" IsEnabled="False"/>
   <Button DockPanel.Dock="Right" x:Name="StartButton" Content="▶ 开始真实自动验证" Style="{StaticResource Primary}" Click="StartClick"/>
  </DockPanel>
 </Grid>
</Window>
