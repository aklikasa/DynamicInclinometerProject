<Window x:Class="Dts.Wpf.TestWindows.CT16.CT16Window"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="CT-16 · 低速运动后归零与恢复 · ACC倾角代理诊断" Width="1240" Height="840"
 MinWidth="1030" MinHeight="680" WindowStartupLocation="CenterOwner"
 Closing="OnClosing" Background="#F3F7FC">
 <Grid Margin="17">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Style="{StaticResource Card}" Padding="15" Margin="0,0,0,10">
   <StackPanel>
    <TextBlock Text="CT-16  /  低速运动后归零与恢复" Style="{StaticResource Title}" FontSize="23"/>
    <TextBlock Text="静态零位基线 → 外轴低速正反往返 → 双轴停稳确认 → 分窗观测ACC推算倾角恢复" Foreground="#4C7197" Margin="0,5,0,0" TextWrapping="Wrap"/>
    <TextBlock Text="注意：当前硬件接口没有设备融合倾角；此版本是 ACC 倾角代理诊断，不得作为融合回零 PASS。" Foreground="#9E651F" Margin="0,6,0,0" TextWrapping="Wrap"/>
    <TextBlock x:Name="DeviceText" Foreground="#185D99" FontFamily="Consolas" Margin="0,6,0,0"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="394"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <Border Style="{StaticResource Card}" Margin="0,0,0,10">
      <StackPanel>
       <TextBlock Text="① 身份与常温标定" Style="{StaticResource Title}"/>
       <TextBlock x:Name="CalibrationText" Foreground="#285F91" TextWrapping="Wrap" Margin="0,7,0,0"/>
       <TextBlock Text="报告根目录" Foreground="#667E94" Margin="0,9,0,0"/>
       <TextBlock x:Name="RootText" TextWrapping="Wrap" Foreground="#235A88" FontSize="12"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,10">
      <StackPanel>
       <TextBlock Text="② 自定义低速往返及恢复参数" Style="{StaticResource Title}"/>
       <TextBlock Text="每轮都从同一外轴零位离开并低速返回；内轴全程固定。支持多档速度和正反方向。" TextWrapping="Wrap" Foreground="#627C95" FontSize="12" Margin="0,6,0,8"/>
       <TextBlock Text="低速档位 (°/s，逗号分隔)"/>
       <TextBox x:Name="SpeedsBox" Text="0.5,1,2" TextChanged="SettingChanged" Margin="0,3,0,8"/>
       <UniformGrid Columns="2">
        <StackPanel Margin="0,0,6,8"><TextBlock Text="每方向重复次数"/><TextBox x:Name="RepeatsBox" Text="1" TextChanged="SettingChanged"/></StackPanel>
        <StackPanel Margin="6,0,0,8"><TextBlock Text="准备定位速度 (°/s)"/><TextBox x:Name="PrepareSpeedBox" Text="1" TextChanged="SettingChanged"/></StackPanel>
        <StackPanel Margin="0,0,6,8"><TextBlock Text="内轴固定姿态 (°)"/><TextBox x:Name="InnerFixedBox" Text="90" TextChanged="SettingChanged"/></StackPanel>
        <StackPanel Margin="6,0,0,8"><TextBlock Text="外轴机械零位 (°)"/><TextBox x:Name="HomeBox" Text="90" TextChanged="SettingChanged"/></StackPanel>
        <StackPanel Margin="0,0,6,8"><TextBlock Text="正反离位幅度 (°)"/><TextBox x:Name="ExcursionBox" Text="10" TextChanged="SettingChanged"/></StackPanel>
        <StackPanel Margin="6,0,0,8"><TextBlock Text="零位基线采集 (秒)"/><TextBox x:Name="BaselineSecBox" Text="5" TextChanged="SettingChanged"/></StackPanel>
        <StackPanel Margin="0,0,6,8"><TextBlock Text="停车后观察 (秒)"/><TextBox x:Name="RecoverySecBox" Text="30" TextChanged="SettingChanged"/></StackPanel>
        <StackPanel Margin="6,0,0,8"><TextBlock Text="每个采样窗口 (秒)"/><TextBox x:Name="BinSecBox" Text="2" TextChanged="SettingChanged"/></StackPanel>
        <StackPanel Margin="0,0,6,8"><TextBlock Text="恢复阈值 (°)"/><TextBox x:Name="ThresholdBox" Text="0.05" TextChanged="SettingChanged"/></StackPanel>
        <StackPanel Margin="6,0,0,8"><TextBlock Text="连续稳定窗口数"/><TextBox x:Name="ConsecutiveBox" Text="3" TextChanged="SettingChanged"/></StackPanel>
        <StackPanel Margin="0,0,6,8"><TextBlock Text="真实到位容差 (°)"/><TextBox x:Name="ToleranceBox" Text="0.10" TextChanged="SettingChanged"/></StackPanel>
        <StackPanel Margin="6,0,0,8"><TextBlock Text="每窗最少真实帧"/><TextBox x:Name="MinFramesBox" Text="40" TextChanged="SettingChanged"/></StackPanel>
        <StackPanel Margin="0,0,6,8"><TextBlock Text="批准角度下界 (°)"/><TextBox x:Name="AllowedMinBox" Text="0" TextChanged="SettingChanged"/></StackPanel>
        <StackPanel Margin="6,0,0,8"><TextBlock Text="批准角度上界 (°)"/><TextBox x:Name="AllowedMaxBox" Text="180" TextChanged="SettingChanged"/></StackPanel>
       </UniformGrid>
       <Button x:Name="PreviewButton" Content="预览并验证全部运动计划" Style="{StaticResource Action}" Click="PreviewClick" Margin="0,7,0,0"/>
       <TextBlock x:Name="PlanSummary" Foreground="#5D7590" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="③ 现场安全确认" Style="{StaticResource Title}"/>
       <CheckBox x:Name="PathApproved" Content="已现场确认内外轴正反路径、真实机械限位、线缆余量" Margin="0,9,0,7"/>
       <CheckBox x:Name="EStopApproved" Content="实体急停有效，运动期间有人监护且区域无障碍" Margin="0,0,0,7"/>
       <TextBlock Text="调整内轴前会将外轴停在0°。允许角度范围只是软件约束，不能替代机械限位。" TextWrapping="Wrap" Foreground="#96652C" FontSize="12"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="13" Margin="0,0,0,10">
     <StackPanel>
      <TextBlock Text="自动动作与运行状态" Style="{StaticResource Title}"/>
      <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="#27649A" FontWeight="SemiBold" Margin="0,7,0,0"/>
      <ProgressBar x:Name="RunProgressBar" Height="8" Minimum="0" Maximum="100" Margin="0,9,0,0"/>
      <TextBlock x:Name="StatusText" Text="请先预览路径并完成现场安全确认。" Foreground="#60798E" TextWrapping="Wrap" Margin="0,6,0,0"/>
     </StackPanel>
    </Border>
    <TabControl x:Name="ResultTabs" Grid.Row="1">
     <TabItem Header="运动计划预览">
      <DataGrid x:Name="PlanGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="31">
       <DataGrid.Columns>
        <DataGridTextColumn Header="组" Binding="{Binding Index}" Width="40"/>
        <DataGridTextColumn Header="低速°/s" Binding="{Binding SpeedDps, StringFormat=F2}" Width="80"/>
        <DataGridTextColumn Header="重复" Binding="{Binding Repeat}" Width="55"/>
        <DataGridTextColumn Header="运动方向" Binding="{Binding Direction}" Width="*"/>
        <DataGridTextColumn Header="内轴°" Binding="{Binding InnerDeg, StringFormat=F2}" Width="70"/>
        <DataGridTextColumn Header="零位°" Binding="{Binding HomeDeg, StringFormat=F2}" Width="70"/>
        <DataGridTextColumn Header="离位角°" Binding="{Binding ExcursionTargetDeg, StringFormat=F2}" Width="80"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
     <TabItem Header="真实恢复结果">
      <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="30">
       <DataGrid.Columns>
        <DataGridTextColumn Header="组" Binding="{Binding Index}" Width="36"/>
        <DataGridTextColumn Header="低速°/s" Binding="{Binding Speed}" Width="75"/>
        <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="*"/>
        <DataGridTextColumn Header="观测峰值°" Binding="{Binding Peak}" Width="98"/>
        <DataGridTextColumn Header="最终偏差°" Binding="{Binding Final}" Width="98"/>
        <DataGridTextColumn Header="恢复上界s" Binding="{Binding Recovery}" Width="90"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
    </TabControl>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0">
     <StackPanel>
      <TextBlock Text="统计、证据和报告" Style="{StaticResource Title}"/>
      <TextBlock x:Name="MetricsText" Text="等待真实数据；不自动判定产品PASS。" Foreground="#2866A0" TextWrapping="Wrap" Margin="0,6,0,0"/>
      <TextBlock x:Name="ReportText" Text="每个恢复窗口的真实物理量CSV、JSON、汇总CSV、Excel与HTML SVG曲线" Foreground="#677D90" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
     </StackPanel>
    </Border>
   </Grid>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
   <Button DockPanel.Dock="Right" x:Name="CloseButton" Content="关闭" Style="{StaticResource Action}" Click="CloseClick"/>
   <Button DockPanel.Dock="Right" x:Name="ReportButton" Content="打开图文报告" Style="{StaticResource Action}" IsEnabled="False" Click="ReportClick"/>
   <Button DockPanel.Dock="Right" x:Name="StopButton" Content="取消 / 双轴软停车" Style="{StaticResource Warning}" IsEnabled="False" Click="StopClick"/>
   <Button DockPanel.Dock="Right" x:Name="StartButton" Content="▶ 一键自动回零诊断" Style="{StaticResource Primary}" Click="StartClick"/>
  </DockPanel>
 </Grid>
</Window>
