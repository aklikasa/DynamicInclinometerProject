<Window x:Class="Dts.Wpf.TestWindows.CT14.CT14Window"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="CT-14 · 重复装夹与复测一致性" Width="1240" Height="860" Closing="OnClosing"
 MinWidth="1050" MinHeight="700" WindowStartupLocation="CenterOwner" Background="#F3F7FC">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="White" CornerRadius="9" Padding="14" Margin="0,0,0,12">
   <StackPanel>
    <TextBlock Text="CT-14 / 重复装夹与复测一致性" FontSize="23" FontWeight="Bold" Foreground="#173B60"/>
    <TextBlock x:Name="DeviceText" Margin="0,6,0,0" Foreground="#23649B"/>
    <TextBlock x:Name="CalibrationText" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#526D86"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer x:Name="SettingsScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <Border Background="White" CornerRadius="9" Padding="13" Margin="0,0,0,10">
      <StackPanel>
       <TextBlock Text="① 装夹与采集参数" FontSize="17" FontWeight="Bold"/>
       <TextBlock Text="独立装夹次数" Margin="0,9,0,3"/><TextBox x:Name="MountCountBox" Text="5"/>
       <TextBlock Text="每个姿态重复采集次数" Margin="0,8,0,3"/><TextBox x:Name="RepeatBox" Text="2"/>
       <TextBlock Text="装夹SOP/定位基准/紧固扭矩/线缆备注" Margin="0,8,0,3"/>
       <TextBox x:Name="MountingSopBox" Height="58" AcceptsReturn="True" TextWrapping="Wrap"
         Text=""/>
       <TextBlock Text="姿态计划（内轴°,外轴°；分号分隔）" Margin="0,8,0,3"/>
       <TextBox x:Name="PoseBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap" Text="0,0;0,90;90,90"/>
       <TextBlock Text="重新上电后统一预热 (s)" Margin="0,8,0,3"/><TextBox x:Name="WarmupBox" Text="120"/>
       <TextBlock Text="转台定位速度 (°/s)" Margin="0,8,0,3"/><TextBox x:Name="SpeedBox" Text="3"/>
       <TextBlock Text="姿态到位后静置 (s)" Margin="0,8,0,3"/><TextBox x:Name="SettleBox" Text="10"/>
       <TextBlock Text="每次真实采集 (s)" Margin="0,8,0,3"/><TextBox x:Name="SampleBox" Text="30"/>
       <TextBlock Text="到位容差 (°)" Margin="0,8,0,3"/><TextBox x:Name="ToleranceBox" Text="0.2"/>
       <TextBlock Text="允许最小角度 (°)" Margin="0,8,0,3"/><TextBox x:Name="MinTravelBox" Text="0"/>
       <TextBlock Text="允许最大角度 (°)" Margin="0,8,0,3"/><TextBox x:Name="MaxTravelBox" Text="360"/>
       <TextBlock Text="最少有效帧" Margin="0,8,0,3"/><TextBox x:Name="MinSamplesBox" Text="50"/>
       <TextBlock Text="最大异常剔除比例" Margin="0,8,0,3"/><TextBox x:Name="MaxOutlierBox" Text="0.10"/>
       <Button Content="检查参数并预览" Click="PreviewClick" Padding="8" Margin="0,12,0,0"/>
      </StackPanel>
     </Border>
     <Border Background="White" CornerRadius="9" Padding="13">
      <StackPanel>
       <TextBlock Text="② 安全与装夹规范确认" FontSize="17" FontWeight="Bold"/>
       <CheckBox x:Name="DirectionCheck" Content="已核对转台轴向、姿态计划和机械允许行程" Margin="0,9,0,5"/>
       <CheckBox x:Name="SafetyCheck" Content="已确认夹具、紧固件、线缆路径、实体急停及现场监护" Margin="0,3,0,5"/>
       <CheckBox x:Name="MountProcedureCheck" Content="已明确每次使用相同定位基准、紧固顺序和扭矩规范" Margin="0,3,0,5"/>
       <CheckBox x:Name="InitialMountCheck" Content="首轮PCB已按规定装夹，完整UID已核验" Margin="0,3,0,5"/>
       <TextBlock Text="每轮重新装夹后，需要重新连接IMU，并在本窗口点击确认。可最小化本窗口，回到主程序重新连接COM口。" TextWrapping="Wrap" Foreground="#8A5A24" Margin="0,8,0,0"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="White" CornerRadius="9" Padding="13" Margin="0,0,0,10">
     <StackPanel>
      <TextBlock Text="测试进度" FontSize="17" FontWeight="Bold"/>
      <TextBlock x:Name="ProgressText" Text="等待开始" Margin="0,6,0,0"/>
      <ProgressBar x:Name="RunProgressBar" Height="9" Minimum="0" Maximum="100" Value="0" Margin="0,8,0,0"/>
      <TextBlock x:Name="StatusText" Text="请先在主界面连接IMU和2TD，并选择当前PCB匹配的常温ACC/Gyro标定。" TextWrapping="Wrap" Foreground="#526D86" Margin="0,8,0,0"/>
     </StackPanel>
    </Border>
    <Border Grid.Row="1" Background="#FFF8E9" CornerRadius="9" Padding="12" Margin="0,0,0,10">
     <StackPanel>
      <TextBlock Text="人工拆装确认" FontWeight="Bold" Foreground="#80521A"/>
      <TextBlock x:Name="MountInstructionText" Text="首轮开始前确认PCB装夹规范。后续每轮结束后，按提示拆卸并重新装夹。" TextWrapping="Wrap" Margin="0,5,0,7"/>
      <CheckBox x:Name="ReinstallCheck" Content="本轮已按同一定位基准完成重新装夹，紧固和走线符合规范" Margin="0,2,0,5"/>
      <CheckBox x:Name="ReconnectCheck" Content="主程序已重新连接IMU，当前完整UID与首轮相同" Margin="0,2,0,7"/>
      <Button x:Name="ConfirmMountButton" Content="确认本轮装夹完成并继续" Click="ConfirmMountClick" Padding="8" IsEnabled="False"/>
     </StackPanel>
    </Border>
    <TabControl Grid.Row="2">
     <TabItem Header="逐次采集">
      <DataGrid x:Name="RunsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
       <DataGrid.Columns>
        <DataGridTextColumn Header="装夹" Binding="{Binding Mount}" Width="55"/>
        <DataGridTextColumn Header="姿态" Binding="{Binding Pose}" Width="55"/>
        <DataGridTextColumn Header="重复" Binding="{Binding Repeat}" Width="55"/>
        <DataGridTextColumn Header="ACC参考误差mg" Binding="{Binding ErrorMg}" Width="110"/>
        <DataGridTextColumn Header="方向差°" Binding="{Binding AngleError}" Width="85"/>
        <DataGridTextColumn Header="Gyro X" Binding="{Binding Gx}" Width="90"/>
        <DataGridTextColumn Header="Gyro Y" Binding="{Binding Gy}" Width="90"/>
        <DataGridTextColumn Header="Gyro Z" Binding="{Binding Gz}" Width="90"/>
        <DataGridTextColumn Header="有效帧" Binding="{Binding Frames}" Width="85"/>
        <DataGridTextColumn Header="温度℃" Binding="{Binding Temp}" Width="75"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
     <TabItem Header="装夹-姿态汇总">
      <DataGrid x:Name="PoseGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
       <DataGrid.Columns>
        <DataGridTextColumn Header="装夹" Binding="{Binding Mount}" Width="65"/>
        <DataGridTextColumn Header="姿态" Binding="{Binding Pose}" Width="65"/>
        <DataGridTextColumn Header="ACC X g" Binding="{Binding Ax}" Width="100"/>
        <DataGridTextColumn Header="ACC Y g" Binding="{Binding Ay}" Width="100"/>
        <DataGridTextColumn Header="ACC Z g" Binding="{Binding Az}" Width="100"/>
        <DataGridTextColumn Header="Gyro X" Binding="{Binding Gx}" Width="100"/>
        <DataGridTextColumn Header="Gyro Y" Binding="{Binding Gy}" Width="100"/>
        <DataGridTextColumn Header="Gyro Z" Binding="{Binding Gz}" Width="100"/>
        <DataGridTextColumn Header="温度℃" Binding="{Binding Temp}" Width="80"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
    </TabControl>
    <Border Grid.Row="3" Background="White" CornerRadius="9" Padding="12" Margin="0,10,0,0">
     <StackPanel>
      <TextBlock Text="跨装夹核心指标" FontWeight="Bold"/>
      <TextBlock x:Name="MetricsText" Text="完成至少2次独立装夹后，才计算同姿态跨装夹ACC/Gyro离散。" TextWrapping="Wrap" Margin="0,5,0,0"/>
      <TextBlock x:Name="OutputText" TextWrapping="Wrap" Foreground="#58738D" Margin="0,5,0,0"/>
     </StackPanel>
    </Border>
   </Grid>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,12,0,0">
   <Button x:Name="StartButton" DockPanel.Dock="Right" Content="开始CT14测试" Click="StartClick" Padding="13,7" Margin="6,0,0,0"/>
   <Button x:Name="StopButton" DockPanel.Dock="Right" Content="停止 / 请求软停车" Click="StopClick" Padding="13,7" IsEnabled="False" Margin="6,0,0,0"/>
   <Button x:Name="ReportButton" DockPanel.Dock="Right" Content="打开最终报告" Click="ReportClick" Padding="13,7" IsEnabled="False" Margin="6,0,0,0"/>
   <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="关闭" Click="CloseClick" Padding="13,7"/>
  </DockPanel>
 </Grid>
</Window>
