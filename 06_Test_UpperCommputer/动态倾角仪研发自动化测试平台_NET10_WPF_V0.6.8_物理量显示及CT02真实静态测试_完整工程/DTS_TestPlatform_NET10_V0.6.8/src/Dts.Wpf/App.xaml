<Application x:Class="Dts.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Blue" Color="#276BCB"/>
    <SolidColorBrush x:Key="Ink" Color="#213A5B"/>
    <SolidColorBrush x:Key="Muted" Color="#6E8298"/>
    <SolidColorBrush x:Key="Outline" Color="#DAE4F0"/>
    <sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="TestTileColumns">2</sys:Int32>

    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Background" Value="#F4F7FC"/>
      <Setter Property="UseLayoutRounding" Value="True"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="#CEDCEE"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#263F60"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TextBox}">
            <Border x:Name="InputBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7" SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#427FD7"/>
              </Trigger>
              <Trigger Property="IsReadOnly" Value="True">
                <Setter TargetName="InputBorder" Property="Background" Value="#F3F6FB"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="InputBorder" Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="#CEDCEE"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="White"/>
    </Style>
    <!-- V0.6.3: compact live status cards beside report/calibration paths. -->
    <Style x:Key="DeviceStatusCard" TargetType="Border">
      <Setter Property="Background" Value="#F2F7FE"/>
      <Setter Property="BorderBrush" Value="#DAE6F5"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="3,1"/>
    </Style>
    <!-- Shared visual language for both embedded and fullscreen IMU telemetry. -->
    <Style x:Key="TelemetryHeader" TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#EAF2FC"/>
      <Setter Property="Foreground" Value="#335A85"/>
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="7,7"/>
      <Setter Property="BorderBrush" Value="#D7E5F5"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <Style x:Key="TelemetryRow" TargetType="DataGridRow">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#E9F0F8"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Style.Triggers>
        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
          <Setter Property="Background" Value="#F8FAFE"/>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#EAF3FF"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#DCEBFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TelemetryCell" TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="7,3"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#243F61"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Foreground" Value="#153A68"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TelemetryGrid" TargetType="DataGrid">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#EDF2F9"/>
      <Setter Property="GridLinesVisibility" Value="None"/>
      <Setter Property="RowStyle" Value="{StaticResource TelemetryRow}"/>
      <Setter Property="CellStyle" Value="{StaticResource TelemetryCell}"/>
      <Setter Property="ColumnHeaderStyle" Value="{StaticResource TelemetryHeader}"/>
    </Style>
    <Style x:Key="TelemetryNumber" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="#224E80"/>
    </Style>
    <Style x:Key="TelemetryStatus" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#A06322"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="ToolTip" Value="{Binding Status}"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="BorderBrush" Value="#E0E8F3"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <!-- All buttons share one true rounded template (rather than square system chrome). -->
    <Style x:Key="RoundedButton" TargetType="Button">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="13,7"/>
      <Setter Property="Background" Value="#EBF3FF"/>
      <Setter Property="BorderBrush" Value="#C7D9F2"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#245A9A"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" SnapsToDevicePixels="True">
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.84"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.68"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#7AB2FD"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
      <Setter Property="Margin" Value="0,0,7,0"/>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Action}">
      <Setter Property="Background" Value="#2D70D3"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#2D70D3"/>
    </Style>
    <Style x:Key="Warning" TargetType="Button" BasedOn="{StaticResource Action}">
      <Setter Property="Background" Value="#BC4554"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#BC4554"/>
    </Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Foreground" Value="#D9E7F7"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="13,10"/>
      <Setter Property="Margin" Value="8,2"/>
      <Setter Property="FontSize" Value="13"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#28517D"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="StageChip" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="13,7"/>
      <Setter Property="Foreground" Value="#56728F"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TabItem}">
            <Border x:Name="TabChrome" Background="#EEF3FA" BorderBrush="#DCE5F0"
                    BorderThickness="1,1,1,0" CornerRadius="8,8,0,0"
                    Padding="{TemplateBinding Padding}" Margin="1,0,3,0">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabChrome" Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#245EA8"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="#DBEBFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Title" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#213C60"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#72849A"/>
      <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style x:Key="TestTile" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Height" Value="100"/>
      <Setter Property="Margin" Value="0,0,9,9"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="#F7FAFE"/>
      <Setter Property="BorderBrush" Value="#D8E5F4"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#E8F2FE"/>
          <Setter Property="BorderBrush" Value="#6A9BE0"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
