<Window x:Class="Dts.Wpf.TestWindows.CT10.CT10Window"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="CT-10 · GYRO 多速率正反向残差" Width="1220" Height="830"
 MinWidth="1020" MinHeight="680" WindowStartupLocation="CenterOwner"
 Closing="OnClosing" Background="#F2F6FC">
 <Window.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="11"/><Setter Property="BorderBrush" Value="#D7E5F3"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15"/></Style>
  <Style TargetType="TextBox"><Setter Property="MinHeight" Value="29"/><Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="0,3,0,7"/><Setter Property="BorderBrush" Value="#CEDDEB"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,5,0,7"/></Style>
  <Style TargetType="Button"><Setter Property="MinHeight" Value="33"/><Setter Property="Padding" Value="14,6"/><Setter Property="Margin" Value="5,0,0,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="#E4EFFA"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="RowHeight" Value="32"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="BorderBrush" Value="#DBE6EF"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/></Style>
 </Window.Resources>
 <Grid Margin="17">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
   <StackPanel>
    <TextBlock Text="CT-10 / GYRO 多速率正反向残差" FontSize="22" FontWeight="SemiBold" Foreground="#215E95"/>
    <TextBlock Text="真实2TD匀速正反运动 · Gyro批次主机接收时标（非传感器逐帧同步）+ 编码器反馈 · 多档速率残差 / 比例系数 / 自动图文报告" TextWrapping="Wrap" Foreground="#587897" Margin="0,5,0,0"/>
    <TextBlock x:Name="UidText" Foreground="#2263A4" Margin="0,7,0,0" FontFamily="Consolas"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <Border Style="{StaticResource Card}" Margin="0,0,0,10">
      <StackPanel>
       <TextBlock Text="① UID / 常温标定 / 动态接口" FontWeight="SemiBold" Foreground="#1E5C91" FontSize="16"/>
       <TextBlock x:Name="CalibrationText" Foreground="#315F87" Margin="0,8,0,3" TextWrapping="Wrap"/>
       <TextBlock x:Name="BridgeText" Foreground="#9C552A" Margin="0,5,0,5" TextWrapping="Wrap"/>
       <TextBlock Text="报告输出根目录" Foreground="#5B7790"/>
       <TextBlock x:Name="OutputText" Foreground="#28639A" TextWrapping="Wrap" Margin="0,2,0,0"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,10">
      <StackPanel>
       <TextBlock Text="② 多速率扫描设置" FontWeight="SemiBold" Foreground="#1E5C91" FontSize="16"/>
       <TextBlock Text="速度档位（°/s；逗号分隔）" Margin="0,10,0,0"/>
       <TextBox x:Name="Speeds" Text="1,5,10" TextChanged="SettingsChanged"/>
       <StackPanel Orientation="Horizontal" Margin="0,3,0,4">
        <CheckBox x:Name="InnerAxis" Content="内轴 Gyro-Z" Margin="0,0,20,0" Checked="AxesChanged" Unchecked="AxesChanged"/>
        <CheckBox x:Name="OuterAxis" Content="外轴 Gyro-X" IsChecked="True" Margin="0" Checked="AxesChanged" Unchecked="AxesChanged"/>
       </StackPanel>
       <UniformGrid Columns="2">
        <StackPanel Margin="0,0,6,0"><TextBlock Text="每档正反配对次数"/><TextBox x:Name="RepeatCount" Text="2" TextChanged="SettingsChanged"/></StackPanel>
        <StackPanel Margin="6,0,0,0"><TextBlock Text="准备定位速度 °/s"/><TextBox x:Name="SetupSpeed" Text="2"/></StackPanel>
        <StackPanel Margin="0,0,6,0"><TextBlock Text="运动行程起点 °"/><TextBox x:Name="TravelMin" Text="30" TextChanged="SettingsChanged"/></StackPanel>
        <StackPanel Margin="6,0,0,0"><TextBlock Text="运动行程终点 °"/><TextBox x:Name="TravelMax" Text="150" TextChanged="SettingsChanged"/></StackPanel>
        <StackPanel Margin="0,0,6,0"><TextBlock Text="现场允许行程下界°"/><TextBox x:Name="ApprovedMin" Text="0"/></StackPanel>
        <StackPanel Margin="6,0,0,0"><TextBlock Text="现场允许行程上界°"/><TextBox x:Name="ApprovedMax" Text="180"/></StackPanel>
        <StackPanel Margin="0,0,6,0"><TextBlock Text="运动前静置 s"/><TextBox x:Name="SettleSeconds" Text="3"/></StackPanel>
        <StackPanel Margin="6,0,0,0"><TextBlock Text="匀速容差比例"/><TextBox x:Name="SpeedTolerance" Text="0.15"/></StackPanel>
        <StackPanel Margin="0,0,6,0"><TextBlock Text="编码器微分窗口 s"/><TextBox x:Name="EncoderWindow" Text="0.4"/></StackPanel>
        <StackPanel Margin="6,0,0,0"><TextBlock Text="每段最少有效帧"/><TextBox x:Name="MinFrames" Text="60"/></StackPanel>
       </UniformGrid>
       <TextBlock Text="Gyro轴方向（必须由实际设备核验后选择）" Foreground="#6E849B" Margin="0,3,0,0"/>
       <StackPanel Orientation="Horizontal">
        <CheckBox x:Name="InvertInner" Content="内轴 Z 反号" Margin="0,4,19,4"/>
        <CheckBox x:Name="InvertOuter" Content="外轴 X 反号" Margin="0,4,0,4"/>
       </StackPanel>
       <Button x:Name="PreviewButton" Content="预览速度与正反扫描计划" Click="PreviewClick" Margin="0,10,0,0"/>
       <TextBlock x:Name="PlanSummary" Margin="0,9,0,0" Foreground="#547493" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="③ 真实运动安全确认" FontWeight="SemiBold" Foreground="#1E5C91" FontSize="16"/>
       <CheckBox x:Name="MotionApproval" Content="实际行程、夹具、线缆和轴运动方向已确认" Margin="0,11,0,4"/>
       <CheckBox x:Name="EmergencyApproval" Content="已确认实体急停有效，现场有人监护" Margin="0,4,0,4"/>
       <CheckBox x:Name="SensorMappingApproval" Content="已核验Gyro X/Z映射及正负方向" Margin="0,4,0,4"/>
       <TextBlock Text="需要完成设备限速、FIFO最新槽位和时间不确定度的现场核验。采用真实运动采样；主机接收时标仅为诊断用途，不等于硬件同步。" Foreground="#A15E2D" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
     <StackPanel>
      <TextBlock Text="自动运行与实时进度" FontWeight="SemiBold" Foreground="#1E5C91" FontSize="16"/>
      <TextBlock x:Name="StatusText" Text="等待真实动态采集适配层" TextWrapping="Wrap" Foreground="#53728E" Margin="0,8,0,0"/>
      <ProgressBar x:Name="RunProgress" Minimum="0" Maximum="100" Height="8" Margin="0,10,0,0"/>
      <TextBlock x:Name="SummaryText" Foreground="#236496" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0"/>
     </StackPanel>
    </Border>
    <TabControl x:Name="ResultTabs" Grid.Row="1">
     <TabItem Header="扫描计划">
      <DataGrid x:Name="PlanGrid" AutoGenerateColumns="False">
       <DataGrid.Columns>
        <DataGridTextColumn Header="轴" Binding="{Binding Axis}" Width="85"/>
        <DataGridTextColumn Header="设定速度 °/s" Binding="{Binding CommandDps}" Width="*"/>
        <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="*"/>
        <DataGridTextColumn Header="第几次" Binding="{Binding Repetition}" Width="*"/>
        <DataGridTextColumn Header="起始角°" Binding="{Binding StartDeg}" Width="*"/>
        <DataGridTextColumn Header="终止角°" Binding="{Binding EndDeg}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
     <TabItem Header="正反残差结果">
      <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False">
       <DataGrid.Columns>
        <DataGridTextColumn Header="轴" Binding="{Binding Axis}" Width="65"/>
        <DataGridTextColumn Header="速度°/s" Binding="{Binding Speed}" Width="80"/>
        <DataGridTextColumn Header="有效对" Binding="{Binding PairCount}" Width="75"/>
        <DataGridTextColumn Header="正残差°/s" Binding="{Binding Forward}" Width="*"/>
        <DataGridTextColumn Header="反残差°/s" Binding="{Binding Reverse}" Width="*"/>
        <DataGridTextColumn Header="正反差°/s" Binding="{Binding Delta}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
    </TabControl>
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0">
     <StackPanel>
      <TextBlock Text="统计结果与自动报告" FontWeight="SemiBold" Foreground="#1E5C91" FontSize="16"/>
      <TextBlock x:Name="MetricsText" Text="完成后显示真实速率残差与正反差，研发待验收。" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#285F98"/>
      <TextBlock x:Name="ReportText" Text="JSON、逐段CSV、速度配对CSV、Excel和带SVG图表的HTML自动保存。" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#648099"/>
     </StackPanel>
    </Border>
   </Grid>
  </Grid>
  <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,12,0,0">
   <Button DockPanel.Dock="Right" Content="关闭" Click="CloseClick"/>
   <Button DockPanel.Dock="Right" x:Name="ReportButton" Content="打开图文报告" Click="ReportClick" IsEnabled="False"/>
   <Button DockPanel.Dock="Right" x:Name="StopButton" Content="停止 / 双轴软停车" Click="StopClick" IsEnabled="False" Background="#FCE8DD"/>
   <Button DockPanel.Dock="Right" x:Name="StartButton" Content="▶ 一键自动动态测试" Click="StartClick" Background="#CBE4FF"/>
  </DockPanel>
 </Grid>
</Window>
