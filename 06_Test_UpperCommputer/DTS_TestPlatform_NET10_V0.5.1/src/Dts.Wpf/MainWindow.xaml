<Window x:Class="Dts.Wpf.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="动态倾角仪研发自动化测试平台 V0.5" Width="1770" Height="1020"
 MinWidth="1430" MinHeight="800" WindowStartupLocation="CenterScreen" Closing="OnClosing">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="55"/><RowDefinition Height="104"/><RowDefinition Height="*"/><RowDefinition Height="150"/></Grid.RowDefinitions>
  <Border Background="#173E70">
   <DockPanel Margin="22,0" LastChildFill="True">
    <TextBlock DockPanel.Dock="Right" Text="真实设备模式  ·  .NET 10  ·  模块化 V0.5" Foreground="#D7EBFF" VerticalAlignment="Center" FontSize="12"/>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="◈" FontSize="28" Foreground="#C4E1FF"/><TextBlock Text="  动态倾角仪研发测试平台" FontSize="22" FontWeight="Bold" Foreground="White"/><TextBlock Text="   /  自动化测试工作台" Foreground="#C2D9F9" VerticalAlignment="Center"/></StackPanel>
   </DockPanel>
  </Border>
  <Border Grid.Row="1" Background="White" BorderBrush="#DCE5F0" BorderThickness="0,0,0,1" Padding="18,8">
   <Grid><Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="45"/></Grid.RowDefinitions>
    <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="当前测试阶段" Style="{StaticResource Label}"/><TextBlock x:Name="StageName" Text="S1 · 常温标定后验证" FontWeight="Bold" Foreground="#245B9B"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="DTS 设备编号" Style="{StaticResource Label}"/><TextBlock x:Name="DeviceNumber" Text="待读取 UID" Foreground="#245B9B" FontWeight="Bold"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="MCU 原始 UID（12字节）" Style="{StaticResource Label}"/><TextBlock x:Name="RawUid" Text="待连接真实 IMU" Foreground="#405979" FontFamily="Consolas"/></StackPanel>
     <StackPanel Grid.Column="3"><TextBlock Text="设备连接" Style="{StaticResource Label}"/><TextBlock x:Name="ConnectionStatus" Text="IMU 离线 / 两套转台离线" Foreground="#AB6430"/></StackPanel>
    </Grid>
    <DockPanel Grid.Row="1" LastChildFill="True" Margin="0,3,0,0">
     <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="选择报告保存目录" Click="ChooseSaveRootClick"/>
     <TextBlock DockPanel.Dock="Left" Text="报告根目录" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#31557C" Margin="0,0,12,0"/>
     <TextBox x:Name="SaveRootText" IsReadOnly="True" Background="#F4F7FC" Text="尚未选择" VerticalContentAlignment="Center" Margin="0,0,12,0"/>
    </DockPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="2" Margin="11,10,11,8"><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/><ColumnDefinition Width="620"/></Grid.ColumnDefinitions>
   <Border Background="#173252" CornerRadius="10" Margin="0,0,10,0">
    <DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="14,5,12,17"><TextBlock Text="原始数据 + UID + 标定版本" Foreground="#BED3EA" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="单测试独立窗口 / 独立报告" Foreground="#BED3EA" FontSize="11" Margin="0,7,0,0"/></StackPanel>
     <StackPanel><TextBlock Text="研发阶段" Foreground="#C2D9F0" FontSize="14" FontWeight="Bold" Margin="18,18,0,12"/>
      <Button Content="⌂   全阶段总览" Style="{StaticResource Nav}" Tag="ALL" Click="StageClick"/>
      <Button Content="◎   S0 常温内参标定" Style="{StaticResource Nav}" Tag="S0" Click="StageClick"/>
      <Button Content="☑   S1 常温标定后验证" Style="{StaticResource Nav}" Tag="S1" Click="StageClick"/>
      <Button Content="♨   S2 全温与温补" Style="{StaticResource Nav}" Tag="S2" Click="StageClick"/>
      <Button Content="〰   S3 动态与抗干扰" Style="{StaticResource Nav}" Tag="S3" Click="StageClick"/>
      <Button Content="⬡   S4 可靠性测试" Style="{StaticResource Nav}" Tag="S4" Click="StageClick"/>
      <Border Height="1" Background="#456588" Margin="15,17"/>
      <Button Content="▤   打开报告数据" Style="{StaticResource Nav}" Click="OpenDataClick"/>
      <Button Content="↻   设备串口扫描" Style="{StaticResource Nav}" Click="ScanClick"/>
     </StackPanel>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1" Margin="0,0,10,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="155"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}">
     <DockPanel><StackPanel DockPanel.Dock="Top" Margin="3,0,3,9"><DockPanel><TextBlock Text="测试项目 · 点击打开独立设置窗口" Style="{StaticResource Title}"/><TextBlock x:Name="CountLabel" DockPanel.Dock="Right" Foreground="#346AB0" FontWeight="Bold"/></DockPanel><TextBlock Text="每个测试都有自己的入口；CT-05 已接入真实设备逐点测试和独立报告，其它项目可逐项补充。" Foreground="#6B7F94" FontSize="12" Margin="0,4,0,0"/></StackPanel>
      <ScrollViewer x:Name="StagesScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="StageGroupsList">
       <ItemsControl.ItemTemplate><DataTemplate><Border Background="#F9FBFE" BorderBrush="#DAE5F3" BorderThickness="1" CornerRadius="8" Margin="2,0,4,12" Padding="11"><StackPanel>
        <DockPanel Margin="0,0,0,9"><TextBlock Text="{Binding Caption}" FontWeight="Bold" Foreground="#23558F"/><TextBlock Text="{Binding Summary}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#718398" FontSize="11"/></DockPanel>
        <ItemsControl ItemsSource="{Binding Tiles}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
         <Button Tag="{Binding}" Click="TestTileClick" Style="{StaticResource TestTile}" ToolTip="{Binding Description}"><Grid Margin="9,6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel><TextBlock Text="{Binding Id}" Foreground="#6B829A" FontSize="11"/><TextBlock Text="{Binding ReadyLabel}" DockPanel.Dock="Right" Foreground="{Binding StatusColor}" FontSize="10"/></DockPanel>
          <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="#1D3B61" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" MaxHeight="34"/>
          <DockPanel Grid.Row="2"><TextBlock Text="{Binding Priority}" Foreground="#718398" FontSize="10"/><TextBlock Text="进入测试设置 ›" DockPanel.Dock="Right" Foreground="#3276BB" FontSize="11"/></DockPanel>
         </Grid></Button>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     </DockPanel>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,9,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel><TextBlock Text="当前选中项目" Style="{StaticResource Title}"/><TextBlock x:Name="SelectedTestState" DockPanel.Dock="Right" Foreground="#B46B35" FontSize="11"/></DockPanel>
     <StackPanel Grid.Row="1" Margin="0,6"><TextBlock x:Name="SelectedTestName" Text="未选择" FontWeight="Bold" Foreground="#1F588E"/><TextBlock x:Name="TestPurpose" Foreground="#52677E" FontSize="12" TextWrapping="Wrap"/><TextBlock x:Name="TestProcedure" Foreground="#74869B" FontSize="11" TextWrapping="Wrap" MaxHeight="31"/></StackPanel>
     <DockPanel Grid.Row="2"><TextBlock x:Name="TestRunStatus" Text="等待操作" DockPanel.Dock="Right" Foreground="#627B94"/><StackPanel Orientation="Horizontal"><TextBox x:Name="DurationSeconds" Text="180" Visibility="Collapsed"/><Button Content="打开测试窗口" Style="{StaticResource Primary}" Click="RunSelectedTestClick"/><Button Content="取消正在执行的测试" Style="{StaticResource Action}" Click="CancelRecordClick"/></StackPanel></DockPanel>
    </Grid></Border>
   </Grid>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Margin="0,0,0,9"><StackPanel>
     <DockPanel><TextBlock Text="IMU · UID / 实时采集" Style="{StaticResource Title}"/><Button x:Name="ScanButton" DockPanel.Dock="Right" Content="自动扫描端口" Style="{StaticResource Primary}" Click="ScanClick"/></DockPanel>
     <WrapPanel Margin="0,7,0,0"><TextBlock Text="COM" VerticalAlignment="Center"/><ComboBox x:Name="ImuPort" Width="90" Margin="7,0,10,0"/><TextBlock Text="波特率" VerticalAlignment="Center"/><TextBox x:Name="ImuBaud" Text="1500000" Width="90" Margin="7,0,10,0"/><TextBlock Text="地址" VerticalAlignment="Center"/><TextBox x:Name="ImuSlave" Text="1" Width="35" Margin="7,0,8,0"/><Button Content="连接并读UID" Style="{StaticResource Action}" Click="ImuConnectClick"/></WrapPanel>
     <DockPanel Margin="0,8,0,0"><TextBlock x:Name="ImuStatus" Text="未连接" Foreground="#4F7399" FontSize="12" TextWrapping="Wrap"/><Button Content="原始数据采集" Style="{StaticResource Action}" DockPanel.Dock="Right" Click="RecordClick"/><TextBox x:Name="ImuRawSeconds" Text="30" Width="55" DockPanel.Dock="Right" Margin="0,0,5,0" ToolTip="原始数据采集秒数"/><Button Content="刷新端口" Style="{StaticResource Action}" DockPanel.Dock="Right" Click="RefreshPortsClick"/></DockPanel>
     <TextBlock x:Name="ScanStatus" Text="尚未扫描" Foreground="#768B9D" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel></Border>
    <TabControl Grid.Row="1" Margin="0,0,0,9">
     <TabItem Header="2TD-600 双轴转台"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="13,12">
      <DockPanel><TextBlock Text="2TD-600 · 双轴独立相对运动" Style="{StaticResource Title}"/><Button DockPanel.Dock="Right" Content="连接转台" Style="{StaticResource Primary}" Click="TdConnectClick"/></DockPanel>
      <WrapPanel Margin="0,9,0,8"><TextBlock Text="COM" VerticalAlignment="Center"/><ComboBox x:Name="TdPort" Width="115" Margin="8,0,16,0"/><TextBlock Text="波特率" VerticalAlignment="Center"/><TextBox x:Name="TdBaud" Text="115200" Width="95" Margin="8,0,0,0"/></WrapPanel>
      <Border Background="#EFF5FD" CornerRadius="7" Padding="12" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="内轴 · 当前位置" Foreground="#607B99"/><TextBlock x:Name="TdInnerAngleText" Text="--" FontFamily="Consolas" Foreground="#205995" FontWeight="Bold" FontSize="24"/><TextBlock x:Name="TdInnerStateText" Text="使能 -- / 到位 --" Foreground="#5E7790" FontSize="11"/></StackPanel>
       <StackPanel Grid.Column="1"><TextBlock Text="外轴 · 当前位置" Foreground="#607B99"/><TextBlock x:Name="TdOuterAngleText" Text="--" FontFamily="Consolas" Foreground="#205995" FontWeight="Bold" FontSize="24"/><TextBlock x:Name="TdOuterStateText" Text="使能 -- / 到位 --" Foreground="#5E7790" FontSize="11"/></StackPanel>
      </Grid></Border>
      <Border BorderBrush="#DBE5F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8"><StackPanel>
       <TextBlock Text="内轴 · 相对运动" FontWeight="Bold" Foreground="#235A92"/>
       <WrapPanel Margin="0,6,0,6"><TextBlock Text="相对角度 (°)" VerticalAlignment="Center"/><TextBox x:Name="TdInnerDelta" Text="50" Width="72" Margin="6,0,13,0"/><TextBlock Text="速率 (°/s)" VerticalAlignment="Center"/><TextBox x:Name="TdInnerSpeed" Text="1" Width="72" Margin="6,0,0,0"/></WrapPanel>
       <WrapPanel><Button Tag="0" Content="使能" Style="{StaticResource Action}" Click="TdAxisEnableClick"/><Button Tag="0" Content="解除" Style="{StaticResource Action}" Click="TdAxisDisableClick"/><Button Tag="0" Content="运行相对角度" Style="{StaticResource Primary}" Click="TdAxisRelativeClick"/><Button Tag="0" Content="停止" Style="{StaticResource Warning}" Click="TdAxisStopClick"/></WrapPanel>
      </StackPanel></Border>
      <Border BorderBrush="#DBE5F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8"><StackPanel>
       <TextBlock Text="外轴 · 相对运动" FontWeight="Bold" Foreground="#235A92"/>
       <WrapPanel Margin="0,6,0,6"><TextBlock Text="相对角度 (°)" VerticalAlignment="Center"/><TextBox x:Name="TdOuterDelta" Text="50" Width="72" Margin="6,0,13,0"/><TextBlock Text="速率 (°/s)" VerticalAlignment="Center"/><TextBox x:Name="TdOuterSpeed" Text="1" Width="72" Margin="6,0,0,0"/></WrapPanel>
       <WrapPanel><Button Tag="2" Content="使能" Style="{StaticResource Action}" Click="TdAxisEnableClick"/><Button Tag="2" Content="解除" Style="{StaticResource Action}" Click="TdAxisDisableClick"/><Button Tag="2" Content="运行相对角度" Style="{StaticResource Primary}" Click="TdAxisRelativeClick"/><Button Tag="2" Content="停止" Style="{StaticResource Warning}" Click="TdAxisStopClick"/></WrapPanel>
      </StackPanel></Border>
      <DockPanel><StackPanel Orientation="Horizontal"><CheckBox x:Name="TdZeroInner" Content="内轴归零" IsChecked="True" Margin="0,0,12,0"/><CheckBox x:Name="TdZeroOuter" Content="外轴归零" IsChecked="True" Margin="0,0,12,0"/></StackPanel><Button DockPanel.Dock="Right" Content="执行所选轴归零（绝对0°）" Style="{StaticResource Primary}" Click="TdZeroClick"/></DockPanel>
      <TextBlock x:Name="TdStatus" Text="未连接；实际反馈到位状态待查询" Foreground="#6F8299" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <Button Content="双轴软停车" Style="{StaticResource Warning}" Click="TdStopClick" Margin="0,8,0,0" HorizontalAlignment="Left"/>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="2FDT600WK 温控双轴转台"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="13,12">
      <DockPanel><TextBlock Text="2FDT600WK · 独立内/外轴" Style="{StaticResource Title}"/><Button DockPanel.Dock="Right" Content="连接温控转台" Style="{StaticResource Primary}" Click="FdtConnectClick"/></DockPanel>
      <WrapPanel Margin="0,9,0,8"><TextBlock Text="内轴COM" VerticalAlignment="Center"/><ComboBox x:Name="FdtInnerPort" Width="103" Margin="6,0,14,0"/><TextBlock Text="外轴COM" VerticalAlignment="Center"/><ComboBox x:Name="FdtOuterPort" Width="103" Margin="6,0,0,0"/></WrapPanel>
      <Border Background="#EFF5FD" CornerRadius="7" Padding="12" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="内轴 · 当前位置" Foreground="#617B97"/><TextBlock x:Name="FdtInnerAngleText" Text="--" FontFamily="Consolas" FontSize="22" Foreground="#205995"/><TextBlock x:Name="FdtInnerStateText" Text="使能/到位待协议确认" FontSize="11" Foreground="#6B8097"/></StackPanel>
       <StackPanel Grid.Column="1"><TextBlock Text="外轴 · 当前位置" Foreground="#617B97"/><TextBlock x:Name="FdtOuterAngleText" Text="--" FontFamily="Consolas" FontSize="22" Foreground="#205995"/><TextBlock x:Name="FdtOuterStateText" Text="使能/到位待协议确认" FontSize="11" Foreground="#6B8097"/></StackPanel>
      </Grid></Border>
      <Border BorderBrush="#DBE5F0" BorderThickness="1" Padding="8" CornerRadius="6" Margin="0,0,0,7"><StackPanel><TextBlock Text="内轴 · 相对角度" FontWeight="Bold"/><WrapPanel Margin="0,5,0,5"><TextBlock Text="角度"/><TextBox x:Name="FdtInnerDelta" Text="5" Width="65" Margin="6,0,12,0"/><TextBlock Text="速率"/><TextBox x:Name="FdtInnerSpeed" Text="1" Width="65" Margin="6,0,0,0"/></WrapPanel><WrapPanel><Button Tag="0" Content="使能" Style="{StaticResource Action}" Click="FdtAxisEnableClick"/><Button Tag="0" Content="解除" Style="{StaticResource Action}" Click="FdtAxisDisableClick"/><Button Tag="0" Content="运行" Style="{StaticResource Primary}" Click="FdtAxisRelativeClick"/><Button Tag="0" Content="停止" Style="{StaticResource Warning}" Click="FdtAxisStopClick"/></WrapPanel></StackPanel></Border>
      <Border BorderBrush="#DBE5F0" BorderThickness="1" Padding="8" CornerRadius="6" Margin="0,0,0,7"><StackPanel><TextBlock Text="外轴 · 相对角度" FontWeight="Bold"/><WrapPanel Margin="0,5,0,5"><TextBlock Text="角度"/><TextBox x:Name="FdtOuterDelta" Text="5" Width="65" Margin="6,0,12,0"/><TextBlock Text="速率"/><TextBox x:Name="FdtOuterSpeed" Text="1" Width="65" Margin="6,0,0,0"/></WrapPanel><WrapPanel><Button Tag="2" Content="使能" Style="{StaticResource Action}" Click="FdtAxisEnableClick"/><Button Tag="2" Content="解除" Style="{StaticResource Action}" Click="FdtAxisDisableClick"/><Button Tag="2" Content="运行" Style="{StaticResource Primary}" Click="FdtAxisRelativeClick"/><Button Tag="2" Content="停止" Style="{StaticResource Warning}" Click="FdtAxisStopClick"/></WrapPanel></StackPanel></Border>
      <DockPanel><WrapPanel><CheckBox x:Name="FdtZeroInner" Content="内轴归零" IsChecked="True" Margin="0,0,12,0"/><CheckBox x:Name="FdtZeroOuter" Content="外轴归零" IsChecked="True"/></WrapPanel><Button DockPanel.Dock="Right" Content="所选轴归零" Style="{StaticResource Primary}" Click="FdtZeroClick"/></DockPanel>
      <TextBlock x:Name="FdtStatus" Text="温控转台未连接" Foreground="#6E8096" TextWrapping="Wrap" FontSize="11" Margin="0,9,0,0"/>
      <Button Content="双轴软停车" Style="{StaticResource Warning}" Click="FdtStopClick" Margin="0,8,0,0" HorizontalAlignment="Left"/>
      <TextBlock Text="注意：厂家 GetStateInfo 的 state 编码尚未提供明确映射，界面将如实显示“待确认”，不虚报使能/到位。温箱PLC是另一通信通道。" Foreground="#9A673A" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"/>
     </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10,9"><StackPanel>
     <TextBlock Text="真实运动安全条件" FontWeight="Bold" Foreground="#9D4E34"/><CheckBox x:Name="SafetyConfirm" Content="已现场确认机械限位、物理急停、夹具、电缆余量和人员撤离" Margin="0,7,0,3"/><TextBlock Text="绝对指令由“当前反馈 + 相对角度”换算；跨 0/360° 边界无法验证旋转方向时禁止运动。软件软停不等于物理急停。" TextWrapping="Wrap" FontSize="11" Foreground="#95643A"/>
    </StackPanel></Border>
   </Grid>
  </Grid>
  <Border Grid.Row="3" Margin="11,0,11,10" Style="{StaticResource Card}" Padding="12,8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel><TextBlock Text="实际执行日志 / 报告输出" Style="{StaticResource Title}"/><Button Content="打开报告根目录" Style="{StaticResource Action}" DockPanel.Dock="Right" Click="OpenDataClick"/></DockPanel>
   <ListBox x:Name="LogList" Grid.Row="1" Margin="0,6,0,0" BorderThickness="0" Background="#F7FAFE" FontFamily="Consolas" FontSize="12"/>
  </Grid></Border>
 </Grid>
</Window>
