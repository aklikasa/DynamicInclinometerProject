<Application x:Class="Dts.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Blue" Color="#266BD1"/>
    <SolidColorBrush x:Key="Ink" Color="#1D3451"/>
    <SolidColorBrush x:Key="Muted" Color="#657991"/>
    <SolidColorBrush x:Key="Outline" Color="#DDE6F1"/>
    <Style TargetType="Window"><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="Background" Value="#F3F6FA"/></Style>
    <Style TargetType="TextBox"><Setter Property="MinHeight" Value="33"/><Setter Property="Padding" Value="7,4"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#D6E1ED"/><Setter Property="Background" Value="#FFFFFF"/></Style>
    <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="33"/><Setter Property="Padding" Value="6,3"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#D6E1ED"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="15"/><Setter Property="BorderBrush" Value="#DFE7F1"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style x:Key="Action" TargetType="Button"><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Padding" Value="13,7"/><Setter Property="MinHeight" Value="33"/><Setter Property="Background" Value="#EBF3FE"/><Setter Property="BorderBrush" Value="#C8DAF5"/><Setter Property="Foreground" Value="#21589B"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Action}"><Setter Property="Background" Value="#286CCD"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#286CCD"/></Style>
    <Style x:Key="Warning" TargetType="Button" BasedOn="{StaticResource Action}"><Setter Property="Background" Value="#BD4149"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#BD4149"/></Style>
    <Style x:Key="Nav" TargetType="Button"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Foreground" Value="#D7E6F9"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,11"/><Setter Property="Margin" Value="8,2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#274E83"/></Trigger></Style.Triggers></Style>
    <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#203C5C"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#64768C"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
    <Style x:Key="TestTile" TargetType="Button"><Setter Property="MinWidth" Value="160"/><Setter Property="Width" Value="181"/><Setter Property="Height" Value="81"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Background" Value="#F8FAFD"/><Setter Property="BorderBrush" Value="#D7E3F1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E9F3FF"/><Setter Property="BorderBrush" Value="#4784D5"/></Trigger></Style.Triggers></Style>
  </Application.Resources>
</Application>
