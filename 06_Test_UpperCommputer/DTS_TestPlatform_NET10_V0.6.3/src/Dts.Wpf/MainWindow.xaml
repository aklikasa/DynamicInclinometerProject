<Window x:Class="Dts.Wpf.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="动态倾角仪研发自动化测试平台 V0.6.3" Width="1500" Height="890"
 MinWidth="760" MinHeight="500" WindowState="Maximized"
 WindowStartupLocation="CenterScreen" Closing="OnClosing" SizeChanged="OnMainSizeChanged">
 <Grid>
  <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="54"/><RowDefinition x:Name="IdentityRow" Height="Auto"/><RowDefinition Height="*"/><RowDefinition x:Name="LogRow" Height="48"/></Grid.RowDefinitions>
  <Border Background="#153C6D">
   <DockPanel Margin="22,0" LastChildFill="True">
    <TextBlock DockPanel.Dock="Right" Text="真实设备模式  ·  .NET 10  ·  V0.6.3 · 布局与状态面板优化" Foreground="#D7EBFF" VerticalAlignment="Center" FontSize="12"/>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="◈" FontSize="28" Foreground="#C4E1FF"/><TextBlock Text="  动态倾角仪研发测试平台" FontSize="22" FontWeight="Bold" Foreground="White"/><TextBlock x:Name="StageName" Text="S1 · 常温标定后验证" Foreground="#C2D9F9" VerticalAlignment="Center" Margin="18,0,0,0"/></StackPanel>
   </DockPanel>
  </Border>
  <!-- Dedicated identity bar. UID never shares a DockPanel row with a stretching button. -->
  <Border x:Name="IdentityBorder" Grid.Row="1" Background="White" BorderBrush="#DBE5F1" BorderThickness="0,0,0,1" Padding="17,9">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="IdentityGap1" Height="7"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="*"/><ColumnDefinition Width="265"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,16,0">
      <TextBlock Text="设备编号 / DTS" Style="{StaticResource Label}"/>
      <TextBlock x:Name="DeviceNumber" Text="待读取 UID" FontSize="19" FontWeight="Bold" Foreground="#2366C5"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Margin="0,0,16,0">
      <TextBlock Text="MCU 原始 UID（12 字节 · 设备身份标识）" Style="{StaticResource Label}"/>
      <DockPanel LastChildFill="True">
       <Button DockPanel.Dock="Right" Content="复制 UID" Click="CopyUidClick" Style="{StaticResource Action}" MinHeight="26" Padding="8,2" FontSize="11" Margin="8,0,0,0" ToolTip="复制当前真实 MCU UID"/>
       <TextBlock x:Name="RawUid" Text="待连接真实 IMU" FontSize="14" FontFamily="Consolas" FontWeight="SemiBold"
                  Foreground="#294C78" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </DockPanel>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="设备连接状态" Style="{StaticResource Label}"/>
      <TextBlock x:Name="ConnectionStatus" Text="IMU 离线 / 两套转台离线" Foreground="#A96635" FontSize="12" TextWrapping="Wrap"/>
     </StackPanel>
    </Grid>
    <!-- Paths occupy a compact left section; live hardware identities remain visible at the right. -->
    <Grid Grid.Row="2">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="11*"/>
      <ColumnDefinition Width="10"/>
      <ColumnDefinition Width="10*"/>
     </Grid.ColumnDefinitions>
     <Expander x:Name="GlobalPathsExpander" Grid.Column="0" IsExpanded="True"
               Header="报告目录 / 标定参数总目录（展开设置）" FontSize="11" Foreground="#315D8A">
      <Grid Margin="4,4,0,0">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="5"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid Grid.Row="0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
        <TextBlock Text="报告目录" VerticalAlignment="Center" Foreground="#4B6382" FontWeight="SemiBold" FontSize="11"/>
        <TextBox Grid.Column="1" x:Name="SaveRootText" IsReadOnly="True" Text="尚未选择" Margin="0,0,7,0" FontSize="11"
                 VerticalContentAlignment="Center" ToolTip="完整报告目录可在文本框中复制；仅用于测试报告"/>
        <Button Grid.Column="2" Content="选择目录" Style="{StaticResource Action}" Click="ChooseSaveRootClick" Margin="0" Padding="5,3" FontSize="11"/>
       </Grid>
       <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
        <TextBlock Text="标定总目录" VerticalAlignment="Center" Foreground="#4B6382" FontWeight="SemiBold" FontSize="11"/>
        <TextBox Grid.Column="1" x:Name="CalibrationRootText" IsReadOnly="True" Text="尚未选择" Margin="0,0,7,0" FontSize="11"
                 VerticalContentAlignment="Center" ToolTip="按 UID 递归查找任意子文件夹中的标定文件；冲突版本拒绝自动选择"/>
        <Button Grid.Column="2" Content="选择目录" Style="{StaticResource Action}" Click="ChooseCalibrationRootClick" Margin="0" Padding="5,3" FontSize="11"/>
       </Grid>
      </Grid>
     </Expander>
     <UniformGrid Grid.Column="2" Columns="3" Margin="0,0,0,1">
      <Border Style="{StaticResource DeviceStatusCard}">
       <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
         <Ellipse x:Name="ImuStateDot" Fill="#A8B7C8" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"/>
         <TextBlock Text="IMU / PCB" FontSize="11" FontWeight="SemiBold" Foreground="#536D89"/>
        </StackPanel>
        <TextBlock x:Name="ImuStateValue" Text="未连接" FontWeight="Bold" FontSize="13" Foreground="#2A496C"/>
        <TextBlock x:Name="ImuStateDetail" Text="等待 UID" FontSize="10" Foreground="#71859B" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource DeviceStatusCard}">
       <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
         <Ellipse x:Name="TdStateDot" Fill="#A8B7C8" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"/>
         <TextBlock Text="2TD-600" FontSize="11" FontWeight="SemiBold" Foreground="#536D89"/>
        </StackPanel>
        <TextBlock x:Name="TdStateValue" Text="未连接" FontWeight="Bold" FontSize="13" Foreground="#2A496C"/>
        <TextBlock x:Name="TdStateDetail" Text="状态待获取" FontSize="10" Foreground="#71859B" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource DeviceStatusCard}">
       <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
         <Ellipse x:Name="FdtStateDot" Fill="#A8B7C8" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"/>
         <TextBlock Text="2FDT 温控转台" FontSize="11" FontWeight="SemiBold" Foreground="#536D89"/>
        </StackPanel>
        <TextBlock x:Name="FdtStateValue" Text="未连接" FontWeight="Bold" FontSize="13" Foreground="#2A496C"/>
        <TextBlock x:Name="FdtStateDetail" Text="状态待获取" FontSize="10" Foreground="#71859B" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
       </StackPanel>
      </Border>
     </UniformGrid>
    </Grid>
   </Grid>
  </Border>
  <Grid x:Name="WorkspaceGrid" Grid.Row="2" Margin="12,10,12,8">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="178"/><ColumnDefinition x:Name="TestsColumn" Width="500"/><ColumnDefinition x:Name="DeviceColumn" Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="NavSidebar" Background="#193859" CornerRadius="12" Margin="0,0,10,0">
    <DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="14,5,12,17"><TextBlock Text="原始数据 + UID + 标定版本" Foreground="#BED3EA" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="单测试独立窗口 / 独立报告" Foreground="#BED3EA" FontSize="11" Margin="0,7,0,0"/></StackPanel>
     <StackPanel><TextBlock Text="研发阶段" Foreground="#C2D9F0" FontSize="14" FontWeight="Bold" Margin="18,18,0,12"/>
      <Button Content="⌂   全阶段总览" Style="{StaticResource Nav}" Tag="ALL" Click="StageClick"/>
      <Button Content="◎   S0 常温内参标定" Style="{StaticResource Nav}" Tag="S0" Click="StageClick"/>
      <Button Content="☑   S1 常温标定后验证" Style="{StaticResource Nav}" Tag="S1" Click="StageClick"/>
      <Button Content="♨   S2 全温与温补" Style="{StaticResource Nav}" Tag="S2" Click="StageClick"/>
      <Button Content="〰   S3 动态与抗干扰" Style="{StaticResource Nav}" Tag="S3" Click="StageClick"/>
      <Button Content="⬡   S4 可靠性测试" Style="{StaticResource Nav}" Tag="S4" Click="StageClick"/>
      <Border Height="1" Background="#456588" Margin="15,17"/>
      <Button Content="▤   打开报告数据" Style="{StaticResource Nav}" Click="OpenDataClick"/>
      <Button Content="↻   设备串口扫描" Style="{StaticResource Nav}" Click="ScanClick"/>
     </StackPanel>
    </DockPanel>
   </Border>
   <Grid x:Name="TestsPanel" Grid.Column="1" Margin="0,0,10,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="SelectedTestRow" Height="155"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}">
     <DockPanel>
      <WrapPanel x:Name="CompactStages" DockPanel.Dock="Top" Visibility="Collapsed" Margin="2,0,2,7">
       <Button Content="全部" Tag="ALL" Style="{StaticResource StageChip}" Click="StageClick"/>
       <Button Content="S0 标定" Tag="S0" Style="{StaticResource StageChip}" Click="StageClick"/>
       <Button Content="S1 常温" Tag="S1" Style="{StaticResource StageChip}" Click="StageClick"/>
       <Button Content="S2 温补" Tag="S2" Style="{StaticResource StageChip}" Click="StageClick"/>
       <Button Content="S3 动态" Tag="S3" Style="{StaticResource StageChip}" Click="StageClick"/>
       <Button Content="S4 可靠性" Tag="S4" Style="{StaticResource StageChip}" Click="StageClick"/>
      </WrapPanel>
      <StackPanel DockPanel.Dock="Top" Margin="3,0,3,9"><DockPanel><TextBlock Text="测试项目 · 点击打开独立设置窗口" Style="{StaticResource Title}"/><TextBlock x:Name="CountLabel" DockPanel.Dock="Right" Foreground="#346AB0" FontWeight="Bold"/></DockPanel><TextBlock Text="每个测试都有自己的入口；CT-05 已接入真实设备逐点测试和独立报告，其它项目可逐项补充。" Foreground="#6B7F94" FontSize="12" Margin="0,4,0,0"/></StackPanel>
      <ScrollViewer x:Name="StagesScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="StageGroupsList">
       <ItemsControl.ItemTemplate><DataTemplate><Border Background="#F9FBFE" BorderBrush="#DAE5F3" BorderThickness="1" CornerRadius="8" Margin="2,0,4,12" Padding="11"><StackPanel>
        <DockPanel Margin="0,0,0,9"><TextBlock Text="{Binding Caption}" FontWeight="Bold" Foreground="#23558F"/><TextBlock Text="{Binding Summary}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#718398" FontSize="11"/></DockPanel>
        <ItemsControl ItemsSource="{Binding Tiles}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{DynamicResource TestTileColumns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
         <Button Tag="{Binding}" Click="TestTileClick" Style="{StaticResource TestTile}" ToolTip="{Binding Description}"><Grid Margin="9,6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel><TextBlock Text="{Binding Id}" Foreground="#6B829A" FontSize="11"/><TextBlock Text="{Binding ReadyLabel}" DockPanel.Dock="Right" Foreground="{Binding StatusColor}" FontSize="10"/></DockPanel>
          <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="#1D3B61" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" MaxHeight="34"/>
          <DockPanel Grid.Row="2"><TextBlock Text="{Binding Priority}" Foreground="#718398" FontSize="10"/><TextBlock Text="进入测试设置 ›" DockPanel.Dock="Right" Foreground="#3276BB" FontSize="11"/></DockPanel>
         </Grid></Button>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     </DockPanel>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,9,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel><TextBlock Text="当前选中项目" Style="{StaticResource Title}"/><TextBlock x:Name="SelectedTestState" DockPanel.Dock="Right" Foreground="#B46B35" FontSize="11"/></DockPanel>
     <StackPanel Grid.Row="1" Margin="0,6"><TextBlock x:Name="SelectedTestName" Text="未选择" FontWeight="Bold" Foreground="#1F588E"/><TextBlock x:Name="TestPurpose" Foreground="#52677E" FontSize="12" TextWrapping="Wrap"/><TextBlock x:Name="TestProcedure" Foreground="#74869B" FontSize="11" TextWrapping="Wrap" MaxHeight="31"/></StackPanel>
     <DockPanel Grid.Row="2"><TextBlock x:Name="TestRunStatus" Text="等待操作" DockPanel.Dock="Right" Foreground="#627B94"/><StackPanel Orientation="Horizontal"><TextBox x:Name="DurationSeconds" Text="180" Visibility="Collapsed"/><Button Content="打开测试窗口" Style="{StaticResource Primary}" Click="RunSelectedTestClick"/><Button Content="取消正在执行的测试" Style="{StaticResource Action}" Click="CancelRecordClick"/></StackPanel></DockPanel>
    </Grid></Border>
   </Grid>
   <!-- The equipment workbench is a full-height view: no nested equipment ScrollViewer.
        Switching between three device tabs leaves the safety acknowledgement visible. -->
   <Grid x:Name="DevicesPanel" Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10,8" Margin="0,0,0,7">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="1,0,1,8" LastChildFill="True">
       <TextBlock DockPanel.Dock="Right" x:Name="WorkbenchDeviceHint" Text="UID 与设备连接状态见顶部" Foreground="#6E829A" VerticalAlignment="Center" FontSize="11"/>
       <TextBlock Text="设备控制工作台" Style="{StaticResource Title}"/>
      </DockPanel>
      <TabControl x:Name="EquipmentTabs" Grid.Row="1" BorderThickness="1" BorderBrush="#D9E4F1" Background="White">
       <TabItem Header="2TD-600 双轴转台">
        <Grid Margin="11,10,11,7">
         <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
         </Grid.RowDefinitions>
         <WrapPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,7">
          <TextBlock Text="串口" VerticalAlignment="Center"/><ComboBox x:Name="TdPort" Width="102" Margin="6,0,12,0"/>
          <TextBlock Text="波特率" VerticalAlignment="Center"/><TextBox x:Name="TdBaud" Text="115200" Width="88" Margin="6,0,12,0"/>
          <Button x:Name="TdScanButton" Content="自动扫描" Width="91" Style="{StaticResource Action}" Click="TdScanClick" Margin="0,0,9,0" ToolTip="被动监听真实 2TD 状态帧；不发送使能或运动指令"/>
          <Button x:Name="TdConnectButton" Content="连接" Width="92" Style="{StaticResource Primary}" Click="TdConnectClick" Margin="0" ToolTip="连接后，仅在安全确认及真实状态正常时尝试自动使能；断开前检查双轴停稳"/>
         </WrapPanel>
         <Border Grid.Row="1" Background="#EFF5FD" CornerRadius="9" Padding="10,7" Margin="0,0,0,7">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <StackPanel><TextBlock Text="内轴 · 实际位置" FontSize="11" Foreground="#657C94"/><TextBlock x:Name="TdInnerAngleText" Text="--" FontFamily="Consolas" FontSize="22" FontWeight="Bold" Foreground="#1F5D9A"/><TextBlock x:Name="TdInnerStateText" Text="使能 -- / 到位 --" FontSize="11" Foreground="#637E96"/></StackPanel>
           <StackPanel Grid.Column="1"><TextBlock Text="外轴 · 实际位置" FontSize="11" Foreground="#657C94"/><TextBlock x:Name="TdOuterAngleText" Text="--" FontFamily="Consolas" FontSize="22" FontWeight="Bold" Foreground="#1F5D9A"/><TextBlock x:Name="TdOuterStateText" Text="使能 -- / 到位 --" FontSize="11" Foreground="#637E96"/></StackPanel>
          </Grid>
         </Border>
         <Grid Grid.Row="2" Margin="0,0,0,7">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" BorderBrush="#D8E5F1" BorderThickness="1" CornerRadius="9" Padding="9,7" Background="#FBFDFF">
           <StackPanel>
            <TextBlock Text="内轴 · 相对运动" FontWeight="Bold" Foreground="#245A94" Margin="0,0,0,6"/>
            <WrapPanel Margin="0,0,0,8"><TextBlock Text="角度 °" VerticalAlignment="Center"/><TextBox x:Name="TdInnerDelta" Text="50" Width="63" Margin="5,0,10,0"/><TextBlock Text="速率 °/s" VerticalAlignment="Center"/><TextBox x:Name="TdInnerSpeed" Text="10" Width="57" Margin="5,0,0,0"/></WrapPanel>
            <StackPanel>
             <TextBlock Text="使能：安全确认后连接时自动使能；实时状态以设备反馈为准" FontSize="11" TextWrapping="Wrap" Foreground="#637E96" Margin="5,2,5,6"/>
             <UniformGrid Columns="2" Rows="1">
              <Button Tag="0" Content="运行相对角度" Style="{StaticResource Primary}" Click="TdAxisRelativeClick" Margin="5,6,5,6"/>
              <Button Tag="0" Content="停止" Style="{StaticResource Warning}" Click="TdAxisStopClick" Margin="5,6,5,6"/>
             </UniformGrid>
            </StackPanel>
           </StackPanel>
          </Border>
          <Border Grid.Column="2" BorderBrush="#D8E5F1" BorderThickness="1" CornerRadius="9" Padding="9,7" Background="#FBFDFF">
           <StackPanel>
            <TextBlock Text="外轴 · 相对运动" FontWeight="Bold" Foreground="#245A94" Margin="0,0,0,6"/>
            <WrapPanel Margin="0,0,0,8"><TextBlock Text="角度 °" VerticalAlignment="Center"/><TextBox x:Name="TdOuterDelta" Text="50" Width="63" Margin="5,0,10,0"/><TextBlock Text="速率 °/s" VerticalAlignment="Center"/><TextBox x:Name="TdOuterSpeed" Text="10" Width="57" Margin="5,0,0,0"/></WrapPanel>
            <StackPanel>
             <TextBlock Text="使能：安全确认后连接时自动使能；实时状态以设备反馈为准" FontSize="11" TextWrapping="Wrap" Foreground="#637E96" Margin="5,2,5,6"/>
             <UniformGrid Columns="2" Rows="1">
              <Button Tag="2" Content="运行相对角度" Style="{StaticResource Primary}" Click="TdAxisRelativeClick" Margin="5,6,5,6"/>
              <Button Tag="2" Content="停止" Style="{StaticResource Warning}" Click="TdAxisStopClick" Margin="5,6,5,6"/>
             </UniformGrid>
            </StackPanel>
           </StackPanel>
          </Border>
         </Grid>
         <StackPanel Grid.Row="3">
          <WrapPanel VerticalAlignment="Center">
           <CheckBox x:Name="TdZeroInner" Content="内轴归零" IsChecked="True" Margin="0,0,10,0"/>
           <CheckBox x:Name="TdZeroOuter" Content="外轴归零" IsChecked="True" Margin="0,0,10,0"/>
           <Button Content="所选轴归零" Width="112" Style="{StaticResource Action}" Click="TdZeroClick" Margin="4,6,10,3"/>
           <Button Content="双轴软停车" Width="110" Style="{StaticResource Warning}" Click="TdStopClick" Margin="4,6,10,3"/>
          </WrapPanel>
          <TextBlock x:Name="TdStatus" Text="未连接；等待状态反馈" Foreground="#627C96" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0" MaxHeight="32"/>
         </StackPanel>
        </Grid>
       </TabItem>
       <TabItem Header="2FDT600WK 温控转台">
        <Grid Margin="11,10,11,7">
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <WrapPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,7">
          <TextBlock Text="内轴 COM" VerticalAlignment="Center"/><ComboBox x:Name="FdtInnerPort" Width="92" Margin="5,0,12,0"/>
          <TextBlock Text="外轴 COM" VerticalAlignment="Center"/><ComboBox x:Name="FdtOuterPort" Width="92" Margin="5,0,12,0"/>
          <Button x:Name="FdtScanButton" Content="自动扫描" Width="91" Style="{StaticResource Action}" Click="FdtScanClick" Margin="0,0,9,0" ToolTip="分别读取温控转台内外轴状态；不发送运动指令"/>
          <Button x:Name="FdtConnectButton" Content="连接" Width="92" Style="{StaticResource Primary}" Click="FdtConnectClick" Margin="0" ToolTip="温控转台保留人工受控使能；断开前先确认双轴停稳"/>
         </WrapPanel>
         <Border Grid.Row="1" Background="#EFF5FD" CornerRadius="9" Padding="10,7" Margin="0,0,0,7">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <StackPanel><TextBlock Text="内轴 · 实际位置" FontSize="11" Foreground="#657C94"/><TextBlock x:Name="FdtInnerAngleText" Text="--" FontFamily="Consolas" FontSize="22" FontWeight="Bold" Foreground="#1F5D9A"/><TextBlock x:Name="FdtInnerStateText" Text="使能/到位待协议确认" FontSize="11" Foreground="#637E96"/></StackPanel>
           <StackPanel Grid.Column="1"><TextBlock Text="外轴 · 实际位置" FontSize="11" Foreground="#657C94"/><TextBlock x:Name="FdtOuterAngleText" Text="--" FontFamily="Consolas" FontSize="22" FontWeight="Bold" Foreground="#1F5D9A"/><TextBlock x:Name="FdtOuterStateText" Text="使能/到位待协议确认" FontSize="11" Foreground="#637E96"/></StackPanel>
          </Grid>
         </Border>
         <Grid Grid.Row="2" Margin="0,0,0,7">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" BorderBrush="#D8E5F1" BorderThickness="1" CornerRadius="9" Padding="9,7" Background="#FBFDFF"><StackPanel>
           <TextBlock Text="内轴 · 相对运动" FontWeight="Bold" Foreground="#245A94" Margin="0,0,0,6"/>
           <WrapPanel Margin="0,0,0,8"><TextBlock Text="角度 °" VerticalAlignment="Center"/><TextBox x:Name="FdtInnerDelta" Text="5" Width="63" Margin="5,0,10,0"/><TextBlock Text="速率 °/s" VerticalAlignment="Center"/><TextBox x:Name="FdtInnerSpeed" Text="1" Width="57" Margin="5,0,0,0"/></WrapPanel>
           <StackPanel>
             <TextBlock Text="厂家使能状态尚无法通过反馈确认，保留人工受控使能" FontSize="11" TextWrapping="Wrap" Foreground="#637E96" Margin="5,2,5,6"/>
             <UniformGrid Columns="2" Rows="2">
              <Button Tag="0" Content="请求使能" Style="{StaticResource Action}" Click="FdtAxisEnableClick" Margin="5,6,5,6"/>
              <Button Tag="0" Content="解除使能" Style="{StaticResource Action}" Click="FdtAxisDisableClick" Margin="5,6,5,6"/>
              <Button Tag="0" Content="运行相对角度" Style="{StaticResource Primary}" Click="FdtAxisRelativeClick" Margin="5,6,5,6"/>
              <Button Tag="0" Content="停止" Style="{StaticResource Warning}" Click="FdtAxisStopClick" Margin="5,6,5,6"/>
             </UniformGrid>
            </StackPanel>
          </StackPanel></Border>
          <Border Grid.Column="2" BorderBrush="#D8E5F1" BorderThickness="1" CornerRadius="9" Padding="9,7" Background="#FBFDFF"><StackPanel>
           <TextBlock Text="外轴 · 相对运动" FontWeight="Bold" Foreground="#245A94" Margin="0,0,0,6"/>
           <WrapPanel Margin="0,0,0,8"><TextBlock Text="角度 °" VerticalAlignment="Center"/><TextBox x:Name="FdtOuterDelta" Text="5" Width="63" Margin="5,0,10,0"/><TextBlock Text="速率 °/s" VerticalAlignment="Center"/><TextBox x:Name="FdtOuterSpeed" Text="1" Width="57" Margin="5,0,0,0"/></WrapPanel>
           <StackPanel>
             <TextBlock Text="厂家使能状态尚无法通过反馈确认，保留人工受控使能" FontSize="11" TextWrapping="Wrap" Foreground="#637E96" Margin="5,2,5,6"/>
             <UniformGrid Columns="2" Rows="2">
              <Button Tag="2" Content="请求使能" Style="{StaticResource Action}" Click="FdtAxisEnableClick" Margin="5,6,5,6"/>
              <Button Tag="2" Content="解除使能" Style="{StaticResource Action}" Click="FdtAxisDisableClick" Margin="5,6,5,6"/>
              <Button Tag="2" Content="运行相对角度" Style="{StaticResource Primary}" Click="FdtAxisRelativeClick" Margin="5,6,5,6"/>
              <Button Tag="2" Content="停止" Style="{StaticResource Warning}" Click="FdtAxisStopClick" Margin="5,6,5,6"/>
             </UniformGrid>
            </StackPanel>
          </StackPanel></Border>
         </Grid>
         <StackPanel Grid.Row="3">
          <WrapPanel VerticalAlignment="Center">
           <CheckBox x:Name="FdtZeroInner" Content="内轴归零" IsChecked="True" Margin="0,0,10,0"/>
           <CheckBox x:Name="FdtZeroOuter" Content="外轴归零" IsChecked="True" Margin="0,0,10,0"/>
           <Button Content="所选轴归零" Width="112" Style="{StaticResource Action}" Click="FdtZeroClick" Margin="4,6,10,3"/>
           <Button Content="双轴软停车" Width="110" Style="{StaticResource Warning}" Click="FdtStopClick" Margin="4,6,10,3"/>
          </WrapPanel>
          <TextBlock x:Name="FdtStatus" Text="温控转台未连接；状态码需确认" Foreground="#627C96" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0" MaxHeight="32"/>
         </StackPanel>
        </Grid>
       </TabItem>
       <TabItem Header="IMU / 采集 / 补偿">
        <Grid Margin="12,12,12,10">
         <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*" MinHeight="40"/>
          <RowDefinition Height="Auto"/>
         </Grid.RowDefinitions>
         <WrapPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,9">
          <TextBlock Text="COM" VerticalAlignment="Center"/><ComboBox x:Name="ImuPort" Width="82" Margin="5,0,10,0"/>
          <TextBlock Text="波特率" VerticalAlignment="Center"/><TextBox x:Name="ImuBaud" Text="1500000" Width="92" Margin="5,0,10,0"/>
          <TextBlock Text="地址" VerticalAlignment="Center"/><TextBox x:Name="ImuSlave" Text="1" Width="45" Margin="5,0,10,0"/>
          <Button x:Name="ImuConnectButton" Content="连接 / 读 UID" Style="{StaticResource Primary}" Click="ImuConnectClick" Margin="0,0,8,0"/>
          <Button x:Name="ScanButton" Content="扫描端口" Width="94" Style="{StaticResource Action}" Click="ScanClick"/>
         </WrapPanel>
         <Border Grid.Row="1" Background="#F3F7FD" BorderBrush="#E1EAF5" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,10">
          <StackPanel>
           <TextBlock x:Name="ImuStatus" Text="IMU 尚未连接" Foreground="#396A9C" FontSize="12" TextWrapping="Wrap"/>
           <WrapPanel Margin="0,4,0,5" VerticalAlignment="Center">
            <TextBlock Text="显示 / 记录模式" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#2F5279" Margin="0,0,11,0"/>
            <CheckBox x:Name="AmbientCompensation" Content="常温标定" Margin="0,0,20,0" Checked="CompensationModeChanged" Unchecked="CompensationModeChanged"/>
            <CheckBox x:Name="ThermalCompensation" Content="全温补偿" Margin="0,0,12,0" Checked="CompensationModeChanged" Unchecked="CompensationModeChanged"/>
            <TextBlock Text="都不选 = 原始计数" VerticalAlignment="Center" FontSize="11" Foreground="#6D8199"/>
           </WrapPanel>
           <CheckBox x:Name="CalibrationOwnership" Margin="0,0,0,3" Checked="CalibrationOptionsChanged" Unchecked="CalibrationOptionsChanged">
            <TextBlock Text="仅短DTS编号匹配：已人工核实文件属于当前PCB" TextWrapping="Wrap" FontSize="11"/>
           </CheckBox>
           <Expander x:Name="ImuDetailsExpander" Header="串口扫描 / 标定匹配 / 详细状态（点击展开）" IsExpanded="True" Foreground="#315D8A" FontSize="11">
            <StackPanel Margin="5,4,0,2">
             <TextBlock x:Name="ScanStatus" Text="串口未扫描" Foreground="#71869D" FontSize="11" TextWrapping="Wrap"/>
             <TextBlock x:Name="CalibrationStatus" Text="未选择标定总目录；仍可保存真实原始计数" TextWrapping="Wrap" Foreground="#8C5A26" FontSize="11" MaxHeight="32"/>
             <TextBlock x:Name="ModeHint" Text="默认原始采集，按 UID 自动加载常温/全温 JSON" TextWrapping="Wrap" Foreground="#8A5E30" FontSize="11"/>
            </StackPanel>
           </Expander>
           <TextBlock x:Name="ImuLiveText" Text="" Visibility="Collapsed"/>
          </StackPanel>
         </Border>
         <Border Grid.Row="2" BorderBrush="#DCE7F4" BorderThickness="1" Background="White" CornerRadius="10" Padding="0" Margin="0,0,0,10">
          <Grid>
           <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
           <DockPanel Margin="10,5,10,4" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="放大表格 ↗" Width="89" MinHeight="27" Padding="6,2" FontSize="11" Style="{StaticResource Action}" Click="OpenImuMonitorClick" Margin="8,0,0,0" ToolTip="独立打开实时数据窗口，高DPI/小屏幕也能完整查看"/>
            <TextBlock x:Name="LiveRowsCountText" DockPanel.Dock="Right" Text="最近 0 帧 / 最多显示 240 帧" Foreground="#67809B" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock x:Name="StreamStatusText" Text="实时六轴：未开始 · 原始计数 (count)" Foreground="#255B95" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
           </DockPanel>
           <DataGrid x:Name="ImuSamplesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                     CanUserResizeColumns="True" CanUserSortColumns="False" CanUserReorderColumns="False"
                     HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="None"
                     Style="{StaticResource TelemetryGrid}" AlternationCount="2"
                     EnableRowVirtualization="True" EnableColumnVirtualization="True"
                     MinHeight="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     SelectionMode="Single" FontFamily="Consolas" FontSize="11" RowHeight="31" ColumnHeaderHeight="34">
            <DataGrid.Columns>
             <DataGridTextColumn Header="时间" Binding="{Binding LocalTime}" Width="93"/>
             <DataGridTextColumn Header="Tick" Binding="{Binding McuTickMs}" Width="76"/>
             <DataGridTextColumn Header="帧" Binding="{Binding SampleIndex}" Width="32"/>
             <DataGridTextColumn Header="Ax" Binding="{Binding Ax}" Width="*" MinWidth="54" ElementStyle="{StaticResource TelemetryNumber}"/>
             <DataGridTextColumn Header="Ay" Binding="{Binding Ay}" Width="*" MinWidth="54" ElementStyle="{StaticResource TelemetryNumber}"/>
             <DataGridTextColumn Header="Az" Binding="{Binding Az}" Width="*" MinWidth="54" ElementStyle="{StaticResource TelemetryNumber}"/>
             <DataGridTextColumn Header="Gx" Binding="{Binding Gx}" Width="*" MinWidth="54" ElementStyle="{StaticResource TelemetryNumber}"/>
             <DataGridTextColumn Header="Gy" Binding="{Binding Gy}" Width="*" MinWidth="54" ElementStyle="{StaticResource TelemetryNumber}"/>
             <DataGridTextColumn Header="Gz" Binding="{Binding Gz}" Width="*" MinWidth="54" ElementStyle="{StaticResource TelemetryNumber}"/>
             <DataGridTextColumn Header="单位 ACC/Gyro" Binding="{Binding Units}" Width="108"/>
             <DataGridTextColumn Header="温度°C" Binding="{Binding TempText}" Width="61"/>
             <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="169" ElementStyle="{StaticResource TelemetryStatus}"/>
            </DataGrid.Columns>
           </DataGrid>
          </Grid>
         </Border>
         <Grid Grid.Row="3" Margin="0,3,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <!-- Manual capture has an independent persistent output root. Reports use the top path. -->
          <Grid Margin="0,0,0,8">
           <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Text="采集数据保存到" VerticalAlignment="Center" Foreground="#365D87" FontWeight="SemiBold" Margin="0,0,9,0" FontSize="12"/>
           <TextBox Grid.Column="1" x:Name="CaptureRootText" IsReadOnly="True" VerticalContentAlignment="Center"
                    Margin="0,0,9,0" ToolTip="仅用于 IMU 手动记录（imu_selected.csv 和 imu_raw.csv）。独立于报告目录。"/>
           <Button Grid.Column="2" Content="选择路径…" Width="95" Style="{StaticResource Action}" Click="ChooseCaptureRootClick" ToolTip="独立保存 IMU 采集数据；会记住上次选择"/>
          </Grid>
          <DockPanel Grid.Row="1" LastChildFill="True">
           <TextBlock x:Name="CaptureFileHint" DockPanel.Dock="Right" Text="主记录 imu_selected.csv ｜原始备份 imu_raw.csv" VerticalAlignment="Center" FontSize="10" Foreground="#71849C" TextWrapping="Wrap"/>
           <WrapPanel VerticalAlignment="Center">
            <Button Content="刷新串口" Width="86" Style="{StaticResource Action}" Click="RefreshPortsClick" Margin="0,0,12,0"/>
            <CheckBox x:Name="TimedCapture" Content="定时自动停止" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="ImuRawSeconds" Text="30" Width="55" Margin="0,0,6,0"/>
            <TextBlock Text="秒" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button x:Name="RecordButton" Content="开始采集" Width="122" Style="{StaticResource Primary}" Click="RecordClick" ToolTip="再次点击为停止；记录与实时表格为同一种模式" Margin="0,0,10,0"/>
           </WrapPanel>
          </DockPanel>
         </Grid>
        </Grid>
       </TabItem>
      </TabControl>
     </Grid>
    </Border>
    <!-- This acknowledgement must never disappear behind scrolling. -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10,7">
     <StackPanel>
      <TextBlock Text="真实运动安全条件" FontWeight="Bold" Foreground="#9D4E34" FontSize="12"/>
      <CheckBox x:Name="SafetyConfirm" Margin="0,3,0,2">
       <TextBlock Text="已确认机械限位、物理急停、夹具、电缆余量与人员安全" TextWrapping="Wrap" FontSize="11"/>
      </CheckBox>
      <TextBlock Text="相对运动 = 实际当前位置 + 增量；跨0/360°且旋转方向不可核实时拒绝运动。软件停车不等于物理急停。" TextWrapping="Wrap" FontSize="10" Foreground="#95643A"/>
     </StackPanel>
    </Border>
   </Grid>
  </Grid>
  <Border Grid.Row="3" Margin="11,0,11,10" Style="{StaticResource Card}" Padding="12,8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel LastChildFill="True">
    <Button DockPanel.Dock="Right" Content="打开报告目录" Style="{StaticResource Action}" Click="OpenDataClick"/>
    <Button x:Name="LogToggleButton" DockPanel.Dock="Right" Content="展开日志" Style="{StaticResource Action}" Click="ToggleLogClick"/>
    <TextBlock Text="实际执行日志 / 报告输出" Style="{StaticResource Title}"/>
   </DockPanel>
   <ListBox x:Name="LogList" Visibility="Collapsed" Grid.Row="1" Margin="0,6,0,0" BorderThickness="0" Background="#F7FAFE" FontFamily="Consolas" FontSize="12"/>
  </Grid></Border>
 </Grid>
</Window>
