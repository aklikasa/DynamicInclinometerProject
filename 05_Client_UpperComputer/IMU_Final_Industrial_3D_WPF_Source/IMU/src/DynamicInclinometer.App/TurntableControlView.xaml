<UserControl x:Class="DynamicInclinometer.App.TurntableControlView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:glass="clr-namespace:DynamicInclinometer.App.Controls"
 Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid MaxWidth="1260" HorizontalAlignment="Stretch" Margin="16,14,16,24">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <DockPanel Grid.Row="0" Margin="4,0,4,14">
    <StackPanel DockPanel.Dock="Left">
     <TextBlock Text="转台手动控制 / Turntable" FontSize="22" FontWeight="SemiBold" Foreground="#F0FAFF"/>
     <TextBlock Text="编码器始终显示绝对角度；运动可选择相对增量或绝对定位。内轴=0，外轴=2。" FontSize="12" Foreground="#AACEDA" Margin="0,4,0,0"/>
    </StackPanel>
   </DockPanel>
   <glass:LiquidGlassPane Grid.Row="1" Style="{StaticResource LiquidGlassCard}" Margin="0,0,0,12" Padding="16">
    <DockPanel LastChildFill="True">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Content="刷新端口" Click="Refresh_Click"/>
      <Button x:Name="ConnectButton" Content="连接转台" Click="Connect_Click" Style="{StaticResource PrimaryAction}"/>
      <Button x:Name="DisconnectButton" Content="安全断开" Click="Disconnect_Click"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="转台端口" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
      <ComboBox x:Name="PortChoice" Width="150" Height="40"/>
      <TextBlock Text="115200 baud" Foreground="#718697" Margin="12,0,0,0" VerticalAlignment="Center"/>
     </StackPanel>
    </DockPanel>
   </glass:LiquidGlassPane>
   <Grid Grid.Row="2" Margin="0,0,0,12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <glass:LiquidGlassPane Grid.Column="0" Style="{StaticResource LiquidGlassCard}" Padding="20">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,12">
       <TextBlock Text="内轴  /  Axis 0" FontSize="17" FontWeight="SemiBold"/>
       <TextBlock Text="Z" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#CADBD7"/>
      </DockPanel>
      <Grid Grid.Row="1" Margin="0,0,0,8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="编码器绝对角度" FontSize="11" Foreground="#BAC9C5"/>
        <TextBlock x:Name="InnerAngleText" Text="---.---°" FontSize="27" FontWeight="SemiBold" Foreground="#DCEAE6" TextWrapping="NoWrap" MinHeight="41"/>
       </StackPanel>
       <StackPanel Grid.Column="1" HorizontalAlignment="Right">
        <TextBlock Text="反馈角速度" FontSize="11" Foreground="#BAC9C5"/>
        <TextBlock x:Name="InnerRateText" Text="--.--- °/s" FontSize="15" FontWeight="SemiBold" TextWrapping="NoWrap"/>
       </StackPanel>
      </Grid>
      <TextBlock Grid.Row="2" x:Name="InnerStatus" Text="未连接" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Height="23" Foreground="#B7C5C2"/>
      <StackPanel Grid.Row="3" Margin="0,9,0,0">
       <TextBlock Text="运动方式" Style="{StaticResource FieldLabel}"/>
       <ComboBox x:Name="InnerPositionMode" SelectedIndex="0" Margin="0,4,0,10">
        <ComboBoxItem Content="相对位置（增量角）"/><ComboBoxItem Content="绝对位置（目标角）"/>
       </ComboBox>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="指令角度 (°)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="InnerTarget" Text="0" Height="41" Margin="0,5,0,0"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="运动速度 (°/s)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SpeedInput" Text="1" Height="41" Margin="0,5,0,0"/></StackPanel>
       </Grid>
      </StackPanel>
      <Button Grid.Row="4" Content="运行内轴" Style="{StaticResource PrimaryAction}" Click="MoveInner_Click" Margin="0,14,0,6"/>
      <StackPanel Grid.Row="5" Orientation="Horizontal">
       <Button Content="使能" Click="EnableInner_Click"/><Button Content="解除使能" Click="DisableInner_Click"/>
       <Button Content="内轴机械回零" Click="HomeInner_Click"/>
      </StackPanel>
     </Grid>
    </glass:LiquidGlassPane>
    <glass:LiquidGlassPane Grid.Column="2" Style="{StaticResource LiquidGlassCard}" Padding="20">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,12">
       <TextBlock Text="外轴  /  Axis 2" FontSize="17" FontWeight="SemiBold"/>
       <TextBlock Text="X" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#CADBD7"/>
      </DockPanel>
      <Grid Grid.Row="1" Margin="0,0,0,8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="编码器绝对角度" FontSize="11" Foreground="#BAC9C5"/>
        <TextBlock x:Name="OuterAngleText" Text="---.---°" FontSize="27" FontWeight="SemiBold" Foreground="#DCEAE6" TextWrapping="NoWrap" MinHeight="41"/>
       </StackPanel>
       <StackPanel Grid.Column="1" HorizontalAlignment="Right">
        <TextBlock Text="反馈角速度" FontSize="11" Foreground="#BAC9C5"/>
        <TextBlock x:Name="OuterRateText" Text="--.--- °/s" FontSize="15" FontWeight="SemiBold" TextWrapping="NoWrap"/>
       </StackPanel>
      </Grid>
      <TextBlock Grid.Row="2" x:Name="OuterStatus" Text="未连接" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Height="23" Foreground="#B7C5C2"/>
      <StackPanel Grid.Row="3" Margin="0,9,0,0">
       <TextBlock Text="运动方式" Style="{StaticResource FieldLabel}"/>
       <ComboBox x:Name="OuterPositionMode" SelectedIndex="0" Margin="0,4,0,10">
        <ComboBoxItem Content="相对位置（增量角）"/><ComboBoxItem Content="绝对位置（目标角）"/>
       </ComboBox>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="指令角度 (°)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OuterTarget" Text="0" Height="41" Margin="0,5,0,0"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="运动速度 (°/s)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OuterSpeedInput" Text="1" Height="41" Margin="0,5,0,0"/></StackPanel>
       </Grid>
      </StackPanel>
      <Button Grid.Row="4" Content="运行外轴" Style="{StaticResource PrimaryAction}" Click="MoveOuter_Click" Margin="0,14,0,6"/>
      <StackPanel Grid.Row="5" Orientation="Horizontal">
       <Button Content="使能" Click="EnableOuter_Click"/><Button Content="解除使能" Click="DisableOuter_Click"/>
       <Button Content="外轴机械回零" Click="HomeOuter_Click"/>
      </StackPanel>
     </Grid>
    </glass:LiquidGlassPane>
   </Grid>
   <glass:LiquidGlassPane Grid.Row="3" Style="{StaticResource LiquidGlassCard}" Padding="15" Margin="0,0,0,12">
    <StackPanel>
     <TextBlock Text="双轴操作" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <WrapPanel>
      <Button Content="双轴使能 / 检查" Click="EnableBoth_Click"/>
      <Button Content="双轴联合运行" Click="MoveBoth_Click" Style="{StaticResource PrimaryAction}"/>
      <Button Content="双轴机械回零" Click="HomeBoth_Click"/>
      <Button x:Name="StopButton" Content="双轴停车" Click="Stop_Click" Style="{StaticResource DangerAction}"/>
     </WrapPanel>
     <TextBlock Text="联动使用厂家 SetUniteAxisAction；双轴机械回零按内轴→外轴顺序执行。设备说明书对部分工装要求另一轴静止，联动前必须确认机械允许。" Foreground="#A5CBDD" FontSize="11" Margin="4,7,0,0" TextWrapping="Wrap"/>
    </StackPanel>
   </glass:LiquidGlassPane>
   <glass:LiquidGlassPane Grid.Row="4" Style="{StaticResource LiquidGlassCard}" Padding="13" Margin="0,0,0,12">
    <TextBlock x:Name="ConnectStatus" Text="未连接 · 请选择 COM 端口" Foreground="#B8DCEC" FontSize="12" TextWrapping="Wrap"/>
   </glass:LiquidGlassPane>
   <Expander Grid.Row="5" Header="诊断日志" IsExpanded="False" Foreground="#3C6176">
    <Border Style="{StaticResource GlassCard}" Padding="12">
     <TextBox x:Name="OperationLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="140" FontSize="11" FontFamily="Consolas" Background="#142338" Foreground="#D8E6F7"/>
    </Border>
   </Expander>
  </Grid>
 </ScrollViewer>
</UserControl>
